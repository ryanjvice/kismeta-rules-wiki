---
import GameMarketingHero from '../../components/GameMarketingHero.astro';
import { getGame } from '../../data/games';
import { AGY_WIKI_PATH } from '../../data/wiki-base';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { siteT } from '../../utils/site-i18n';
import agyHero from '../../assets/games/agy/hero.png';
import agyHeroMobile from '../../assets/games/agy/hero-mobile.png';
import agyWordmark from '../../assets/games/agy/wordmark.svg';

const game = getGame('alchemists-of-the-great-year');
if (!game) throw new Error('Missing AGY game config');

const title = game.title;
const description = siteT('game.agy.pageDescription');

const actions = [
	{
		href: `${AGY_WIKI_PATH}play/guided/`,
		label: siteT('game.agy.action.play'),
		variant: 'primary' as const,
	},
	{
		href: `${AGY_WIKI_PATH}lore/`,
		label: siteT('game.agy.action.learn'),
		variant: 'secondary' as const,
	},
	{
		href: `${AGY_WIKI_PATH}rules/round-at-a-glance/`,
		label: siteT('game.agy.action.round'),
		variant: 'minimal' as const,
	},
	{
		href: '/shop/',
		label: siteT('game.agy.action.shop'),
		variant: 'minimal' as const,
	},
];
---

<SiteLayout {title} {description} gameSlug={game.slug}>
	<GameMarketingHero
		title={title}
		subtitle={game.subtitle}
		tagline={siteT('game.agy.tagline')}
		summary={siteT(game.summaryKey)}
		playersLabel={siteT('site.meta.players')}
		playersValue={siteT('game.agy.players')}
		playTimeLabel={siteT('site.meta.playTime')}
		playTimeValue={siteT('game.agy.playTime')}
		heroImage={agyHero}
		heroImageMobile={agyHeroMobile}
		wordmarkImage={agyWordmark}
		{actions}
	/>
</SiteLayout>
