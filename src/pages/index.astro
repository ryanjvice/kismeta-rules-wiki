---
import { Image } from 'astro:assets';
import MailingListSignup from '../components/MailingListSignup.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import logo from '../assets/logo.svg';
import { agyPlaytestConfig } from '../data/playtest';
import { siteT } from '../utils/site-i18n';

const title = siteT('site.enter.pageTitle');
const description = siteT('site.enter.metaDescription');
---

<SiteLayout {title} {description} showChartWheel hideChrome>
	<section class="site-enter" aria-labelledby="enter-title">
		<Image
			class="site-enter__logo"
			src={logo}
			alt=""
			width={400}
			height={160}
			loading="eager"
		/>
		<h1 id="enter-title" class="sr-only">{siteT('site.enter.title')}</h1>
		<p class="site-enter__tagline">{siteT('site.enter.tagline')}</p>
		<a class="site-enter__cta" href="/home/">{siteT('site.enter.cta')}</a>

		<aside class="site-enter__panel" aria-labelledby="mailing-heading">
			<h2 id="mailing-heading" class="site-enter__panel-heading">
				{siteT('site.enter.mailingHeading')}
			</h2>
			<p class="site-enter__panel-summary">{siteT('site.enter.mailingSummary')}</p>
			<MailingListSignup />
		</aside>

		<aside class="site-enter__panel site-enter__panel--playtest" aria-labelledby="playtest-heading">
			<h2 id="playtest-heading" class="site-enter__panel-heading">
				{siteT('site.enter.playtestHeading')}
			</h2>
			<p class="site-enter__panel-summary">{siteT('site.enter.playtestSummary')}</p>
			<a class="site-enter__panel-cta" href={agyPlaytestConfig.path}>
				{siteT('site.enter.playtestCta')}
			</a>
		</aside>
	</section>
</SiteLayout>
