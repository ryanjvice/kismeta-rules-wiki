---
import DefaultHeader from '@astrojs/starlight/components/Header.astro';
import TabNav from './TabNav.astro';
import { getWikiNav } from '../data/wiki-nav';

const wikiConfig = getWikiNav(Astro.url.pathname);
---

<div class="kismeta-header-wrap">
	<DefaultHeader {...Astro.props} />
	{
		wikiConfig && (
			<div class="wiki-breadcrumb">
				<a href="/" class="wiki-breadcrumb__home">Kismeta</a>
				<span class="wiki-breadcrumb__sep" aria-hidden="true">›</span>
				<span class="wiki-breadcrumb__game">{wikiConfig.gameLabel}</span>
			</div>
		)
	}
	<TabNav />
</div>

<script is:inline>
	// Apply stored sidebar-collapsed state before first paint to prevent flash.
	try {
		if (localStorage.getItem('kismeta-sidebar-collapsed') === 'true'
			&& window.matchMedia('(min-width: 50rem)').matches) {
			document.documentElement.dataset.kismetaSidebarCollapsed = 'true';
		}
	} catch (_) {}
	// Apply stored font-size preference before first paint to prevent flash.
	try {
		var _fs = localStorage.getItem('kismeta-font-size');
		if (_fs && _fs !== 'default') {
			document.documentElement.dataset.kismetaFontSize = _fs;
		}
	} catch (_) {}
</script>

<script>
	import '../scripts/game-modes.ts';
	import '../scripts/nav-offset.ts';
</script>
