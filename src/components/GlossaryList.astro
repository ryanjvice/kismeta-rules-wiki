---
import { getRelativeLocaleUrl } from 'astro:i18n';
import glossaryEn from '../data/glossary.json';

const locale = Astro.currentLocale ?? 'root';
const glossary = glossaryEn;

function pathFor(slug: string) {
	return getRelativeLocaleUrl(locale, slug);
}

const termLinks: Record<string, string> = {
	Opposition: pathFor('play/round-overview') + '#2-opposition',
	Gambit: pathFor('play/round-overview') + '#6-gambit',
	Harvest: pathFor('play/round-overview') + '#3-harvest-kismeta-cards',
	'Alignment Points': pathFor('reference/quick-reference') + '#alignment-point-sources',
	'Alignment Bonus': pathFor('reference/quick-reference') + '#alignment-scoring',
	'Alignment Score': pathFor('reference/quick-reference') + '#alignment-point-sources',
	Reagent: pathFor('play/round-overview') + '#3-craft-reagents',
	Refinement: pathFor('play/round-overview') + '#3-craft-reagents',
	'Crucible Card': pathFor('play/round-overview') + '#1-activate-crucible-cards',
	'Astral House': pathFor('play/round-overview') + '#2-build-astral-houses',
	'Offering to the Age': pathFor('play/round-overview') + '#2-offering-to-the-age',
	'Fateful Wager': pathFor('play/round-overview') + '#3-fateful-wager',
	Transmutation: pathFor('reference/quick-reference') + '#crucible-the-transmutation-pathway',
	Stasis: pathFor('play/round-overview') + '#3-crucible-actions',
	Tempering: pathFor('play/round-overview') + '#3-crucible-actions',
	"Philosopher's Stone": pathFor('reference/quick-reference') + '#philosophers-stone-states',
	Crucible: pathFor('reference/quick-reference') + '#crucible-the-transmutation-pathway',
	'Cosmic Age': pathFor('reference/quick-reference') + '#cosmic-ages--effects',
	'Cosmic Effect': pathFor('reference/quick-reference') + '#cosmic-ages--effects',
	Agekeeper: pathFor('play/setup') + '#v-determine-the-first-agekeeper',
	Activating: pathFor('play/round-overview') + '#1-activate-crucible-cards',
};

function linkForTerm(term: string) {
	return termLinks[term] ?? null;
}

function linkifyDefinition(text: string) {
	const alignment = pathFor('reference/quick-reference') + '#alignment-point-sources';
	const opposition = pathFor('play/round-overview') + '#2-opposition';
	const gambit = pathFor('play/round-overview') + '#6-gambit';

	return text
		.replace(
			/See 1\.1: Alignment Points\.?/gi,
			`See [Alignment Points](${alignment}).`
		)
		.replace(/See 1\.1 Alignment Points\.?/gi, `See [Alignment Points](${alignment}).`)
		.replace(/See 1\.12 Opposition\.?/gi, `See [Opposition](${opposition}).`)
		.replace(/See 1\.10 Gambit\.?/gi, `See [Gambit](${gambit}).`);
}
---

<div class="glossary-list">
	{
		glossary.map((entry) => {
			const href = linkForTerm(entry.term);
			return (
				<section class="glossary-entry" id={entry.term.toLowerCase().replace(/[^a-z0-9]+/g, '-')}>
					<h2>
						{href ? (
							<a href={href}>{entry.term}</a>
						) : (
							entry.term
						)}
					</h2>
					<p set:html={linkifyDefinition(entry.definition)} />
				</section>
			);
		})
	}
</div>

<style>
	.glossary-list {
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
	}
	.glossary-entry h2 {
		font-size: var(--sl-text-h3);
		margin-bottom: 0.35rem;
	}
	.glossary-entry h2 a {
		color: var(--sl-color-accent);
		text-decoration: none;
	}
	.glossary-entry h2 a:hover {
		text-decoration: underline;
	}
	.glossary-entry p {
		margin: 0;
		line-height: 1.6;
	}
</style>
