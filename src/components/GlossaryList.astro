---
import { getRelativeLocaleUrl } from 'astro:i18n';
import glossaryEn from '../data/glossary.json';

const locale = Astro.currentLocale ?? 'root';
const glossary = glossaryEn;

function pathFor(slug: string) {
	return getRelativeLocaleUrl(locale, slug);
}

const termLinks: Record<string, string> = {
	Opposition: pathFor('reference/compendium/1-12-opposition'),
	Gambit: pathFor('reference/compendium/1-10-gambit'),
	Harvest: pathFor('reference/compendium/1-2-harvest'),
	'Alignment Points': pathFor('reference/compendium/1-1-aspects-alignment') + '#alignment-points',
	'Alignment Bonus': pathFor('reference/compendium/1-1-aspects-alignment') + '#alignment-points',
	'Alignment Score': pathFor('reference/compendium/1-1-aspects-alignment') + '#alignment-points',
	Reagent: pathFor('reference/compendium/1-6-reagents'),
	Refinement: pathFor('reference/compendium/1-6-reagents'),
	'Crucible Card': pathFor('reference/compendium/1-4-crucible-cards'),
	'Astral House': pathFor('reference/compendium/1-7-astral-houses'),
	'Offering to the Age': pathFor('reference/compendium/1-13-offering-to-the-age'),
	'Fateful Wager': pathFor('reference/compendium/1-14-fateful-wager'),
	Transmutation: pathFor('reference/compendium/1-11-crucible-philosophers-stone'),
	Stasis: pathFor('reference/compendium/1-11-crucible-philosophers-stone') + '#returning-from-stasis',
	Tempering: pathFor('reference/compendium/1-11-crucible-philosophers-stone'),
	"Philosopher's Stone": pathFor('reference/compendium/1-11-crucible-philosophers-stone'),
	Crucible: pathFor('reference/compendium/1-11-crucible-philosophers-stone'),
	'Cosmic Age': pathFor('reference/compendium/1-0-cosmic-ages'),
	'Cosmic Effect': pathFor('reference/compendium/1-0-cosmic-ages'),
	Agekeeper: pathFor('play/setup') + '#v-selecting-the-first-agekeeper',
	Activating: pathFor('reference/compendium/1-4-crucible-cards') + '#activating-a-crucible-card',
};

function linkForTerm(term: string) {
	return termLinks[term] ?? null;
}

function linkifyDefinition(text: string) {
	const alignment = pathFor('reference/compendium/1-1-aspects-alignment') + '#alignment-points';
	const opposition = pathFor('reference/compendium/1-12-opposition');
	const gambit = pathFor('reference/compendium/1-10-gambit');

	return text
		.replace(
			/See 1\.1: Alignment Points\.?/gi,
			`See [Alignment Points](${alignment}).`
		)
		.replace(/See 1\.1 Alignment Points\.?/gi, `See [Alignment Points](${alignment}).`)
		.replace(/See 1\.12 Opposition\.?/gi, `See [Opposition](${opposition}).`)
		.replace(/See 1\.10 Gambit\.?/gi, `See [Gambit](${gambit}).`);
}
---

<div class="glossary-list">
	{
		glossary.map((entry) => {
			const href = linkForTerm(entry.term);
			return (
				<section class="glossary-entry" id={entry.term.toLowerCase().replace(/[^a-z0-9]+/g, '-')}>
					<h2>
						{href ? (
							<a href={href}>{entry.term}</a>
						) : (
							entry.term
						)}
					</h2>
					<p set:html={linkifyDefinition(entry.definition)} />
				</section>
			);
		})
	}
</div>

<style>
	.glossary-list {
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
	}
	.glossary-entry h2 {
		font-size: var(--sl-text-h3);
		margin-bottom: 0.35rem;
	}
	.glossary-entry h2 a {
		color: var(--sl-color-accent);
		text-decoration: none;
	}
	.glossary-entry h2 a:hover {
		text-decoration: underline;
	}
	.glossary-entry p {
		margin: 0;
		line-height: 1.6;
	}
</style>
