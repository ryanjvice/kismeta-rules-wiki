---
import { getRelativeLocaleUrl } from 'astro:i18n';

const locale = Astro.currentLocale ?? 'root';
const t = Astro.locals.t;

const tabs = [
	{ key: 'tab.play',       path: 'play/guided' },
	{ key: 'tab.learn',      path: 'learn/lore' },
	{ key: 'tab.compendium', path: 'reference/quick-reference' },
] as const;

const pathname = Astro.url.pathname;
---

<nav class="tab-nav" aria-label="Rules sections">
	{
		tabs.map((tab) => {
			const href = getRelativeLocaleUrl(locale, tab.path);
			const active =
				pathname === '/' || pathname === `/${locale}/`
					? tab.key === 'tab.play'
					: tab.key === 'tab.play'
						? pathname.includes('/play/')
						: tab.key === 'tab.learn'
							? pathname.includes('/learn/') || pathname.includes('/glossary/')
							: pathname.includes('/reference/');
			return (
				<a href={href} class:list={['tab-nav__link', { 'tab-nav__link--active': active }]}>
					{t(tab.key)}
				</a>
			);
		})
	}
</nav>
