---
import { getRelativeLocaleUrl } from 'astro:i18n';

const locale = Astro.currentLocale ?? 'root';
const t = Astro.locals.t;

const tabs = [
	{ key: 'tab.play',  path: 'play/guided' },
	{ key: 'tab.rules', path: 'learn/components' },
	{ key: 'tab.lore',  path: 'lore' },
] as const;

const pathname = Astro.url.pathname;

const rulesPlayPaths = ['/play/setup/', '/play/round-overview/'];
---

<nav class="tab-nav" aria-label="Rules sections">
	{
		tabs.map((tab) => {
			const href = getRelativeLocaleUrl(locale, tab.path);
			const active =
				pathname === '/' || pathname === `/${locale}/`
					? tab.key === 'tab.play'
					: tab.key === 'tab.lore'
						? pathname.includes('/lore/')
						: tab.key === 'tab.play'
							? (pathname.includes('/play/') && !rulesPlayPaths.some((path) => pathname.includes(path))) ||
							  pathname.includes('/glossary/') ||
							  pathname.includes('/reference/')
							: pathname.includes('/learn/') || pathname.includes('/rules/') || rulesPlayPaths.some((path) => pathname.includes(path));
			return (
				<a
					href={href}
					class:list={['tab-nav__link', { 'tab-nav__link--active': active }]}
					aria-current={active ? 'page' : undefined}
				>
					{t(tab.key)}
				</a>
			);
		})
	}
</nav>
