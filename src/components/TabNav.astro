---
import { getRelativeLocaleUrl } from 'astro:i18n';

const locale = Astro.currentLocale ?? 'root';
const t = Astro.locals.t;

const tabs = [
	{ key: 'tab.play',  path: 'play/guided' },
	{ key: 'tab.rules', path: 'learn/components' },
	{ key: 'tab.lore',  path: 'lore' },
] as const;

const pathname = Astro.url.pathname;
---

<nav class="tab-nav" aria-label="Rules sections">
	{
		tabs.map((tab) => {
			const href = getRelativeLocaleUrl(locale, tab.path);
			const active =
				pathname === '/' || pathname === `/${locale}/`
					? tab.key === 'tab.play'
					: tab.key === 'tab.lore'
						? pathname.includes('/lore/')
						: tab.key === 'tab.play'
							? (pathname.includes('/play/') && !pathname.includes('/play/setup/')) ||
							  pathname.includes('/glossary/') ||
							  (pathname.includes('/reference/') && !pathname.includes('/reference/compendium/'))
							: pathname.includes('/learn/') || pathname.includes('/play/setup/') ||
							  pathname.includes('/reference/compendium/');
			return (
				<a href={href} class:list={['tab-nav__link', { 'tab-nav__link--active': active }]}>
					{t(tab.key)}
				</a>
			);
		})
	}
</nav>
