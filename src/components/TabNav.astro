---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { getWikiNav } from '../data/wiki-nav';

const locale = Astro.currentLocale ?? 'root';
const t = Astro.locals.t;

const pathname = Astro.url.pathname;
const config = getWikiNav(pathname);

type ResolvedTab = { href: string; label: string; active: boolean };
let resolvedTabs: ResolvedTab[] = [];

if (config) {
	const prefix = `/${config.base}/`;
	const isHome = pathname === prefix || pathname === prefix.slice(0, -1);
	// Relative path from wiki root, e.g. "play/guided/"
	const relPath = isHome ? '' : pathname.slice(prefix.length);

	const isLore = relPath.startsWith('lore/');
	const isRules =
		!isHome && config.rulesPrefixes.some((p) => relPath.startsWith(p));
	const isPlay =
		isHome ||
		(!isRules &&
			!isLore &&
			(relPath.startsWith('play/') ||
				config.playExtraPrefixes.some((p) => relPath.startsWith(p))));

	resolvedTabs = config.tabs.map((tab) => ({
		href: getRelativeLocaleUrl(locale, `${config.base}/${tab.path}`),
		label: t(tab.key),
		active:
			tab.key === 'tab.lore'
				? isLore
				: tab.key === 'tab.rules'
					? isRules
					: isPlay,
	}));
}
---

{
	config && (
		<nav
			class="tab-nav"
			aria-label="Rules sections"
			data-tab-nav
			data-label-collapse={t('tabnav.collapse')}
			data-label-expand={t('tabnav.expand')}
		>
			{resolvedTabs.map(({ href, label, active }) => (
				<a
					href={href}
					class:list={['tab-nav__link', { 'tab-nav__link--active': active }]}
					aria-current={active ? 'page' : undefined}
				>
					{label}
				</a>
			))}
			<button
				type="button"
				class="tab-nav__toggle"
				data-tab-nav-toggle
				aria-expanded="true"
				aria-label={t('tabnav.collapse')}
			>
				<svg
					class="tab-nav__toggle-icon"
					aria-hidden="true"
					width="14"
					height="14"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="2.5"
					stroke-linecap="round"
					stroke-linejoin="round"
				>
					<path d="M18 15l-6-6-6 6"/>
				</svg>
			</button>
		</nav>
	)
}

<script>
	const STORAGE_KEY = 'kismeta-tabnav-collapsed';

	function applyTabNavState(nav: HTMLElement, collapsed: boolean) {
		if (collapsed) {
			document.documentElement.dataset.kismetaTabnavCollapsed = 'true';
		} else {
			delete document.documentElement.dataset.kismetaTabnavCollapsed;
		}
		const btn = nav.querySelector<HTMLButtonElement>('[data-tab-nav-toggle]');
		if (btn) {
			btn.setAttribute('aria-expanded', collapsed ? 'false' : 'true');
			btn.setAttribute(
				'aria-label',
				collapsed ? (nav.dataset.labelExpand ?? '') : (nav.dataset.labelCollapse ?? '')
			);
		}
	}

	function initTabNav() {
		const nav = document.querySelector<HTMLElement>('[data-tab-nav]');
		if (!nav || nav.dataset.bound === 'true') return;
		nav.dataset.bound = 'true';

		const stored = localStorage.getItem(STORAGE_KEY) === 'true';
		applyTabNavState(nav, stored);

		const btn = nav.querySelector<HTMLButtonElement>('[data-tab-nav-toggle]');
		btn?.addEventListener('click', () => {
			const isCollapsed = document.documentElement.dataset.kismetaTabnavCollapsed === 'true';
			const next = !isCollapsed;
			applyTabNavState(nav, next);
			localStorage.setItem(STORAGE_KEY, String(next));
		});
	}

	document.addEventListener('astro:page-load', initTabNav);
	initTabNav();
</script>
