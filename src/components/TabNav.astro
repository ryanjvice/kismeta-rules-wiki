---
import { getRelativeLocaleUrl } from 'astro:i18n';

const locale = Astro.currentLocale ?? 'root';
const t = Astro.locals.t;

const tabs = [
	{ key: 'tab.learn', path: 'learn/lore' },
	{ key: 'tab.play', path: 'play/round-at-a-glance' },
	{ key: 'tab.guided', path: 'play/guided' },
	{ key: 'tab.reference', path: 'reference/quick-reference' },
	{ key: 'tab.glossary', path: 'glossary' },
] as const;

const pathname = Astro.url.pathname;
const learnHref = getRelativeLocaleUrl(locale, 'learn/lore');
---

<nav class="tab-nav" aria-label="Rules sections">
	{
		tabs.map((tab) => {
			const href = getRelativeLocaleUrl(locale, tab.path);
			const matchPath = `/${tab.path.split('/')[0]}/`;
			const isGuided = tab.path === 'play/guided';
			const active =
				pathname === '/' || pathname === `/${locale}/`
					? href === learnHref
					: isGuided
						? pathname.includes('/play/guided')
						: pathname.includes(matchPath) && !pathname.includes('/play/guided');
			return (
				<a href={href} class:list={['tab-nav__link', { 'tab-nav__link--active': active }]}>
					{t(tab.key)}
				</a>
			);
		})
	}
</nav>
