---
/**
 * A simplified 3-step guided play stepper for Kismeta: The Veiled Ascent.
 * No game-mode selector, no context rules panel — just the three gameplay steps
 * with navigation and optional "learn more" links.
 */
import { getRelativeLocaleUrl } from 'astro:i18n';
import { tvaSlug } from '../data/wiki-base';
import TVA_GUIDED_STEPS, { getTvaNavSections } from '../data/tva-guided-steps';

const locale = Astro.currentLocale ?? 'root';
const t = Astro.locals.t;

const steps = TVA_GUIDED_STEPS.map((step) => ({
	...step,
	learnMoreUrl: step.learnMorePath
		? getRelativeLocaleUrl(locale, tvaSlug(step.learnMorePath))
		: undefined,
}));

const navSections = getTvaNavSections();
const totalSteps = steps.length;
---

<div
	class="tva-guided-play"
	data-steps={JSON.stringify(steps)}
	data-total={totalSteps}
	data-nav-sections={JSON.stringify(navSections)}
	data-labels={JSON.stringify({
		navTrigger: t('guided.nav.trigger'),
		navTitle: t('guided.nav.title'),
		progress: t('guided.progress'),
	})}
>
	<div class="tva-guided-play__header">
		<p class="tva-guided-play__progress" data-tva-progress>
			{t('guided.progress').replace('{current}', '1').replace('{total}', String(totalSteps))}
		</p>
		<div class="guided-play__nav">
			<button
				type="button"
				class="guided-play__nav-trigger"
				data-nav-trigger
				aria-expanded="false"
				aria-controls="tva-guided-play-nav-panel"
				aria-label={t('guided.nav.trigger')}
			>
				{t('guided.nav.trigger')}
			</button>
			<div
				id="tva-guided-play-nav-panel"
				class="guided-play__nav-panel"
				data-nav-panel
				role="menu"
				aria-label={t('guided.nav.title')}
				hidden
			>
				{
					navSections.map((section) => (
						<button
							type="button"
							class="guided-play__nav-item"
							role="menuitem"
							data-nav-section={section.id}
							data-nav-step={section.stepIndex}
						>
							{section.label}
						</button>
					))
				}
			</div>
		</div>
	</div>

	{/* Step cards rendered server-side; JS toggles visibility */}
	{
		steps.map((step, idx) => (
			<div
				class="tva-guided-play__step"
				data-step-idx={idx}
				hidden={idx !== 0}
			>
				<h2 class="tva-guided-play__title">
					{step.title}
					{step.subtitle && (
						<span class="tva-guided-play__subtitle"> — {step.subtitle}</span>
					)}
				</h2>
				<div class="tva-guided-play__body" set:html={step.body} />
				{step.checklist && step.checklist.length > 0 && (
					<ul class="tva-guided-play__checklist">
						{step.checklist.map((item) => (
							<li>{item}</li>
						))}
					</ul>
				)}
				{step.learnMoreUrl && (
					<a
						href={step.learnMoreUrl}
						class="tva-guided-play__learn-more"
					>
						{t('guided.learnMore')}
					</a>
				)}
			</div>
		))
	}

	<div class="tva-guided-play__footer">
		<button
			type="button"
			class="tva-guided-play__btn tva-guided-play__btn--back"
			aria-label={t('guided.back')}
			hidden
		>
			{t('guided.back')}
		</button>
		<button
			type="button"
			class="tva-guided-play__btn tva-guided-play__btn--next"
			aria-label={t('guided.next')}
		>
			{t('guided.next')}
		</button>
	</div>
</div>

<script>
	type NavSection = {
		id: string;
		label: string;
		stepIndex: number;
	};

	type Labels = {
		navTrigger: string;
		navTitle: string;
		progress: string;
	};

	function initTvaStepper(el: HTMLElement) {
		if (el.dataset.bound === 'true') return;
		el.dataset.bound = 'true';

		const steps = el.querySelectorAll<HTMLElement>('.tva-guided-play__step');
		const backBtn = el.querySelector<HTMLButtonElement>('.tva-guided-play__btn--back');
		const nextBtn = el.querySelector<HTMLButtonElement>('.tva-guided-play__btn--next');
		const progressEl = el.querySelector<HTMLElement>('[data-tva-progress]')!;
		const navTrigger = el.querySelector<HTMLButtonElement>('[data-nav-trigger]')!;
		const navPanel = el.querySelector<HTMLElement>('[data-nav-panel]')!;
		const navSections = JSON.parse(el.dataset.navSections || '[]') as NavSection[];
		const labels = JSON.parse(el.dataset.labels || '{}') as Labels;
		const total = steps.length;
		let current = 0;
		let navOpen = false;

		const getCurrentSectionId = (index: number): string => {
			return navSections[index]?.id ?? navSections[0]?.id ?? '';
		};

		const syncNavActive = () => {
			const activeId = getCurrentSectionId(current);
			el.querySelectorAll<HTMLButtonElement>('[data-nav-section]').forEach((btn) => {
				const isActive = btn.dataset.navSection === activeId;
				btn.setAttribute('aria-current', isActive ? 'true' : 'false');
				btn.classList.toggle('guided-play__nav-item--active', isActive);
			});
		};

		const closeNavPanel = () => {
			navOpen = false;
			navPanel.hidden = true;
			navTrigger.setAttribute('aria-expanded', 'false');
		};

		const openNavPanel = () => {
			navOpen = true;
			navPanel.hidden = false;
			navTrigger.setAttribute('aria-expanded', 'true');
			syncNavActive();
			navPanel.querySelector<HTMLElement>('[data-nav-section]')?.focus();
		};

		navTrigger.addEventListener('click', () => {
			if (navOpen) {
				closeNavPanel();
				navTrigger.focus();
			} else {
				openNavPanel();
			}
		});

		navPanel.addEventListener('keydown', (e: KeyboardEvent) => {
			if (e.key === 'Escape') {
				e.stopPropagation();
				closeNavPanel();
				navTrigger.focus();
			}
		});

		document.addEventListener('click', (e: MouseEvent) => {
			const nav = el.querySelector('.guided-play__nav');
			if (navOpen && nav && !nav.contains(e.target as Node)) {
				closeNavPanel();
			}
		});

		el.querySelectorAll<HTMLButtonElement>('[data-nav-section]').forEach((btn) => {
			btn.addEventListener('click', () => {
				const target = Number(btn.dataset.navStep);
				if (!target) return;
				showStep(target - 1);
				closeNavPanel();
				navTrigger.focus();
			});
		});

		function showStep(idx: number) {
			steps.forEach((s, i) => {
				s.hidden = i !== idx;
			});
			if (backBtn) backBtn.hidden = idx === 0;
			if (nextBtn) nextBtn.hidden = idx === total - 1;
			current = idx;
			progressEl.textContent = labels.progress
				.replace('{current}', String(idx + 1))
				.replace('{total}', String(total));
			syncNavActive();
			el.scrollIntoView({ behavior: 'smooth', block: 'start' });
		}

		backBtn?.addEventListener('click', () => showStep(Math.max(0, current - 1)));
		nextBtn?.addEventListener('click', () => showStep(Math.min(total - 1, current + 1)));

		showStep(0);
	}

	document.addEventListener('astro:page-load', () => {
		document.querySelectorAll<HTMLElement>('.tva-guided-play').forEach(initTvaStepper);
	});
	document.querySelectorAll<HTMLElement>('.tva-guided-play').forEach(initTvaStepper);
</script>

<style>
	.tva-guided-play {
		max-width: 44rem;
		margin: 0 auto;
	}

	.tva-guided-play__header {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 0.75rem;
		margin-bottom: 0.5rem;
	}

	.tva-guided-play__progress {
		font-size: 0.85rem;
		font-weight: 600;
		color: var(--sl-color-gray-3);
		text-transform: uppercase;
		letter-spacing: 0.04em;
		margin: 0;
		flex: 1;
		min-width: 0;
	}

	.tva-guided-play__step {
		padding: 0.5rem 0 1rem;
	}

	.tva-guided-play__title {
		font-family: var(--kismeta-font-heading);
		font-size: clamp(1.2rem, 3vw, 1.6rem);
		margin-bottom: 0.75rem;
	}

	.tva-guided-play__subtitle {
		font-size: 0.8em;
		color: var(--sl-color-text-accent);
		font-weight: 400;
	}

	.tva-guided-play__body {
		line-height: 1.7;
		margin-bottom: 1rem;
	}

	.tva-guided-play__checklist {
		list-style: none;
		padding: 0;
		margin: 0 0 1.25rem;
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
	}

	.tva-guided-play__checklist li {
		display: flex;
		align-items: flex-start;
		gap: 0.6rem;
		padding: 0.45rem 0.7rem;
		background: color-mix(in srgb, var(--sl-color-accent) 8%, transparent);
		border-radius: 0.35rem;
		font-size: 0.95rem;
		line-height: 1.5;
	}

	.tva-guided-play__checklist li::before {
		content: '›';
		color: var(--sl-color-accent-high);
		flex-shrink: 0;
		font-weight: 700;
	}

	.tva-guided-play__learn-more {
		display: inline-block;
		font-size: 0.9rem;
		color: var(--sl-color-text-accent);
		text-decoration: underline;
		text-underline-offset: 0.2em;
		margin-bottom: 0.75rem;
	}

	.tva-guided-play__footer {
		display: flex;
		gap: 0.75rem;
		padding-top: 1rem;
		border-top: 1px solid var(--sl-color-hairline);
	}

	.tva-guided-play__btn {
		padding: 0.5rem 1.25rem;
		border-radius: 0.35rem;
		border: 1px solid var(--sl-color-accent);
		background: transparent;
		color: var(--sl-color-accent-high);
		font-family: var(--kismeta-font-heading);
		font-size: 0.9rem;
		cursor: pointer;
		transition: background 0.15s;
	}

	.tva-guided-play__btn--next {
		background: var(--sl-color-accent);
		color: var(--kismeta-on-accent, #fff);
	}

	.tva-guided-play__btn:hover {
		background: color-mix(in srgb, var(--sl-color-accent) 80%, transparent);
		color: var(--kismeta-on-accent, #fff);
	}
</style>
