---
import { siteT } from '../utils/site-i18n';

const socialLinks = [
	{ id: 'x', href: 'https://x.com/kismeta_game', labelKey: 'site.social.x' as const },
	{ id: 'discord', href: 'https://discord.gg/qEe2UYSnt', labelKey: 'site.social.discord' as const },
];
---

<footer class="kismeta-site-footer site-layout__footer">
	<nav class="kismeta-site-footer__social" aria-label={siteT('site.social.aria')}>
		<ul>
			{
				socialLinks.map(({ id, href, labelKey }) => (
					<li>
						<a href={href} data-social={id} target="_blank" rel="noopener noreferrer">
							{siteT(labelKey)}
						</a>
					</li>
				))
			}
		</ul>
	</nav>
	<p class="kismeta-site-footer__copyright">{siteT('site.copyright')}</p>
</footer>
