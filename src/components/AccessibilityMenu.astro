---
const t = Astro.locals.t;
---

<div class="a11y-menu">
	<!--
		Disclosure trigger — aria-expanded and aria-controls link the button to
		the panel; the SVG is purely decorative (aria-hidden).
	-->
	<button
		type="button"
		class="a11y-menu__trigger"
		data-a11y-trigger
		aria-expanded="false"
		aria-controls="kismeta-a11y-panel"
		aria-label={t('a11y.menuLabel')}
	>
		<!-- Universal accessibility person icon -->
		<svg
			class="a11y-menu__icon"
			viewBox="0 0 24 24"
			width="18"
			height="18"
			fill="currentColor"
			aria-hidden="true"
			focusable="false"
		>
			<circle cx="12" cy="4.5" r="2.25"/>
			<path d="M17.5 8.5H6.5a.75.75 0 0 0 0 1.5h4.25v2.72l-2.47 5.94a.75.75 0 1 0 1.39.58L12 14l2.33 5.24a.75.75 0 0 0 1.39-.58L13.25 12.72V10h4.25a.75.75 0 0 0 0-1.5z"/>
		</svg>
	</button>

	<!--
		Settings panel — starts hidden; shown/hidden via JS (accessibility.ts).
		Uses the disclosure pattern: no role="dialog", no aria-modal.
		The aria-expanded/aria-controls relationship on the trigger is sufficient
		for AT to understand the panel's relationship to the button.
	-->
	<div
		id="kismeta-a11y-panel"
		class="a11y-menu__panel"
		data-a11y-panel
		hidden
	>
		<!-- ── Theme ──────────────────────────────────────────────── -->
		<div class="a11y-menu__group" role="group" aria-labelledby="a11y-theme-heading">
			<span class="a11y-menu__group-label" id="a11y-theme-heading">
				{t('a11y.themeLabel')}
			</span>
			<div class="a11y-menu__options">
				<button
					type="button"
					class="a11y-menu__option"
					aria-pressed="false"
					data-a11y-theme="dark"
				>
					{t('a11y.themeDark')}
				</button>
				<button
					type="button"
					class="a11y-menu__option"
					aria-pressed="false"
					data-a11y-theme="light"
				>
					{t('a11y.themeLight')}
				</button>
				<button
					type="button"
					class="a11y-menu__option"
					aria-pressed="true"
					data-a11y-theme="auto"
				>
					{t('a11y.themeSystem')}
				</button>
			</div>
		</div>

		<!-- ── Text size ──────────────────────────────────────────── -->
		<div class="a11y-menu__group" role="group" aria-labelledby="a11y-fontsize-heading">
			<span class="a11y-menu__group-label" id="a11y-fontsize-heading">
				{t('a11y.fontSizeLabel')}
			</span>
			<div class="a11y-menu__options">
				<button
					type="button"
					class="a11y-menu__option"
					aria-pressed="true"
					data-a11y-fontsize="default"
				>
					{t('a11y.fontDefault')}
				</button>
				<button
					type="button"
					class="a11y-menu__option"
					aria-pressed="false"
					data-a11y-fontsize="lg"
				>
					{t('a11y.fontLarge')}
				</button>
				<button
					type="button"
					class="a11y-menu__option"
					aria-pressed="false"
					data-a11y-fontsize="xl"
				>
					{t('a11y.fontLarger')}
				</button>
			</div>
		</div>
	</div>
</div>

<script>
	import '../scripts/accessibility.ts';
</script>
