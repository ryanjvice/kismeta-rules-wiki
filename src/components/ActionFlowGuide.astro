---
import { getRelativeLocaleUrl } from 'astro:i18n';
import {
	getFlow,
	localize,
	type FlowId,
	type FlowNode,
	type StoneState,
} from '../data/content-registry';

interface Props {
	flowId: FlowId;
}

const { flowId } = Astro.props;
const locale = Astro.currentLocale === 'pt-br' ? 'pt-br' : 'en';
const flow = getFlow(flowId);
const intro = localize(flow.intro, locale);
const learnPath = 'play/round-overview';
const roundOverviewUrl = getRelativeLocaleUrl(locale, learnPath);
const learnBase = flow.learnMoreHash
	? `${roundOverviewUrl}#${flow.learnMoreHash}`
	: roundOverviewUrl;

const isSummer = flow.mode === 'playerTurn';
const isAutumn = flowId === 'autumn-flow';

const labels = {
	required: locale === 'pt-br' ? 'Obrigatório' : 'Required',
	optional: locale === 'pt-br' ? 'Opcional' : 'Optional',
	choice: locale === 'pt-br' ? 'Escolha' : 'Choose',
	sequence: locale === 'pt-br' ? 'Em ordem' : 'In order',
	appliesWhen: locale === 'pt-br' ? 'Aplica-se quando:' : 'Applies when:',
	likelySkip: locale === 'pt-br' ? 'Provavelmente pule neste turno.' : 'Likely skip on your turn.',
	readMore: locale === 'pt-br' ? 'Ler regras completas' : 'Read full rules',
	pickPrompt:
		locale === 'pt-br' ? 'Toque para ver o lembrete' : 'Tap an action for a quick reminder',
	stonePickerTitle:
		locale === 'pt-br' ? 'Onde está sua Pedra do Filósofo?' : 'Where is your Philosopher\'s Stone?',
	stoneAll: locale === 'pt-br' ? 'Mostrar todos' : 'Show all steps',
	stoneStasis: locale === 'pt-br' ? 'Em Estase' : 'In Stasis',
	stoneForgingNew:
		locale === 'pt-br' ? 'Forjando — 1ª rodada na Forja' : 'Forging — first round in Forge',
	stoneForgingReady:
		locale === 'pt-br' ? 'Forjando — desde a rodada anterior' : 'Forging — since last round',
	stoneNotInForge:
		locale === 'pt-br' ? 'No Anel do Manto (não forjando)' : 'In Mantle Ring (not Forging)',
	processionLabel:
		locale === 'pt-br' ? 'Duas passagens na mesa' : 'Two passes around the table',
	passLikelySkip:
		locale === 'pt-br' ? 'Provavelmente pule esta passagem.' : 'Likely skip this pass.',
};

const stonePickerOptions: Array<{ id: StoneState; label: string }> = [
	{ id: 'all', label: labels.stoneAll },
	{ id: 'stasis', label: labels.stoneStasis },
	{ id: 'forgingNew', label: labels.stoneForgingNew },
	{ id: 'forgingReady', label: labels.stoneForgingReady },
	{ id: 'notInForge', label: labels.stoneNotInForge },
];

function topGroups(node: FlowNode): FlowNode[] {
	return node.children ?? [];
}

const topLevel = isSummer ? topGroups(flow.root) : [flow.root];
const autumnPasses = isAutumn
	? (flow.root.children ?? []).filter((n) => n.id.startsWith('pass-'))
	: [];

/** Global step numbers 1–4 across both autumn passes */
const autumnStepNumbers: Record<string, number> = {
	'leave-stasis': 1,
	opposition: 2,
	temper: 3,
	fire: 4,
};

function stoneStatesAttr(states: StoneState[] | undefined): string {
	if (!states?.length) return 'all';
	return states.join(' ');
}
---

<div
	class:list={['action-flow', 'action-flow--interactive', { 'action-flow--autumn': isAutumn }]}
	data-flow-id={flowId}
	data-flow-mode={flow.mode}
	data-locale={locale}
	data-learn-base={roundOverviewUrl}
	data-learn-path={learnPath}
	data-labels={JSON.stringify(labels)}
>
	{intro && <p class="action-flow__intro">{intro}</p>}

	<p class="action-flow__hint">{labels.pickPrompt}</p>

	{isAutumn && (
		<div class="action-flow__stone-picker-wrap">
			<h3 class="action-flow__stone-picker-title" id={`stone-picker-${flowId}`}>
				{labels.stonePickerTitle}
			</h3>
			<div
				class="action-flow__stone-picker"
				role="group"
				aria-labelledby={`stone-picker-${flowId}`}
				data-stone-picker
			>
				{stonePickerOptions.map((opt) => (
					<button
						type="button"
						class="action-flow__stone-segment"
						data-stone={opt.id}
						aria-pressed={opt.id === 'all' ? 'true' : 'false'}
					>
						{opt.label}
					</button>
				))}
			</div>
		</div>
	)}

	{isSummer ? (
		<div class="action-flow__summer" data-summer-root>
			<div class="action-flow__groups" role="group" aria-label={localize(flow.root.label, locale)}>
				{topLevel.map((group) => (
					<div class="action-flow__group" data-group-id={group.id}>
						<h3 class="action-flow__group-title">{localize(group.label, locale)}</h3>
						<div class="action-flow__group-actions">
							{(group.children ?? []).map((action) => (
								<button
									type="button"
									class="action-flow__pick"
									data-pick-id={action.id}
									data-body={localize(action.body, locale)}
									data-condition={localize(action.condition, locale)}
									data-learn-hash={action.learnMoreHash ?? ''}
									data-mode-notes={JSON.stringify(action.gameModeNote ?? {})}
								>
									{localize(action.label, locale)}
								</button>
							))}
						</div>
					</div>
				))}
			</div>
		</div>
	) : isAutumn ? (
		<div class="action-flow__procession" data-procession>
			<p class="action-flow__procession-label">{labels.processionLabel}</p>
			{autumnPasses.map((pass) => (
				<section class="action-flow__pass" data-pass-id={pass.id}>
					<h3 class="action-flow__pass-title">{localize(pass.label, locale)}</h3>
					{pass.body && (
						<p class="action-flow__pass-body">{localize(pass.body, locale)}</p>
					)}
					<p class="action-flow__pass-skip-note" data-pass-skip-note hidden>
						{labels.passLikelySkip}
					</p>
					<ol class="action-flow__procession-steps">
						{(pass.children ?? []).map((step) => (
							<li
								class:list={[
									'action-flow__procession-step',
									`action-flow__node--${step.kind}`,
								]}
								data-node-id={step.id}
								data-stone-states={stoneStatesAttr(step.stoneStates)}
								data-pass-id={pass.id}
							>
								<div class="action-flow__procession-marker" aria-hidden="true">
									{autumnStepNumbers[step.id] ?? '?'}
								</div>
								<div class="action-flow__procession-content">
									{!step.children?.length && step.learnMoreHash ? (
										<button
											type="button"
											class="action-flow__pick action-flow__pick--step"
											data-pick-id={step.id}
											data-body={localize(step.body, locale)}
											data-condition={localize(step.condition, locale)}
											data-learn-hash={step.learnMoreHash}
										>
											<span class="action-flow__pick-step-inner">
												<span class="action-flow__node-head">
													{step.kind === 'sequence' && (
														<span class="action-flow__badge action-flow__badge--sequence">
															{labels.sequence}
														</span>
													)}
													{step.kind === 'required' && (
														<span class="action-flow__badge action-flow__badge--required">
															{labels.required}
														</span>
													)}
													{step.kind === 'optional' && (
														<span class="action-flow__badge action-flow__badge--optional">
															{labels.optional}
														</span>
													)}
													<span class="action-flow__node-label">
														{localize(step.label, locale)}
													</span>
												</span>
												{step.condition && (
													<span class="action-flow__condition action-flow__condition--applies">
														<em>
															{step.kind === 'sequence' ? labels.appliesWhen : ''}{' '}
															{localize(step.condition, locale)}
														</em>
													</span>
												)}
											</span>
										</button>
									) : (
										<>
											<div class="action-flow__node-head">
												{step.kind === 'sequence' && (
													<span class="action-flow__badge action-flow__badge--sequence">
														{labels.sequence}
													</span>
												)}
												{step.kind === 'required' && (
													<span class="action-flow__badge action-flow__badge--required">
														{labels.required}
													</span>
												)}
												{step.kind === 'optional' && (
													<span class="action-flow__badge action-flow__badge--optional">
														{labels.optional}
													</span>
												)}
												<span class="action-flow__node-label">{localize(step.label, locale)}</span>
											</div>
											{step.condition && (
												<p class="action-flow__condition action-flow__condition--applies">
													<em>
														{step.kind === 'sequence' ? labels.appliesWhen : ''}{' '}
														{localize(step.condition, locale)}
													</em>
												</p>
											)}
											{step.body && (
												<p class="action-flow__body">{localize(step.body, locale)}</p>
											)}
										</>
									)}
									<p class="action-flow__skip-note" data-skip-note hidden>
										{labels.likelySkip}
									</p>
									{step.children && step.children.length > 0 && (
										<div class="action-flow__branches">
											{step.children.map((branch) => (
												<div class="action-flow__branch">
													<button
														type="button"
														class="action-flow__pick"
														data-pick-id={branch.id}
														data-body={localize(branch.body, locale)}
														data-condition={localize(branch.condition, locale)}
														data-learn-hash={branch.learnMoreHash ?? step.learnMoreHash ?? ''}
													>
														{localize(branch.label, locale)}
													</button>
													{branch.children?.map((sub) => (
														<button
															type="button"
															class="action-flow__pick action-flow__pick--sub"
															data-pick-id={sub.id}
															data-body={localize(sub.body, locale)}
															data-learn-hash={sub.learnMoreHash ?? branch.learnMoreHash ?? ''}
														>
															{localize(sub.label, locale)}
														</button>
													))}
												</div>
											))}
										</div>
									)}
									{step.learnMoreHash && step.children?.length ? (
										<a
											class="action-flow__learn-more"
											href={`${roundOverviewUrl}#${step.learnMoreHash}`}
											target="_blank"
											rel="noopener"
										>
											{labels.readMore}
										</a>
									) : null}
								</div>
							</li>
						))}
					</ol>
				</section>
			))}
		</div>
	) : (
		<ol class="action-flow__tree action-flow__tree--guided">
			{(flow.root.children ?? []).map((step) => (
				<li class={`action-flow__node action-flow__node--${step.kind}`} data-node-id={step.id}>
					<div class="action-flow__node-head">
						{step.kind === 'sequence' && (
							<span class="action-flow__badge action-flow__badge--sequence">{labels.sequence}</span>
						)}
						{step.kind === 'required' && (
							<span class="action-flow__badge action-flow__badge--required">{labels.required}</span>
						)}
						{step.kind === 'optional' && (
							<span class="action-flow__badge action-flow__badge--optional">{labels.optional}</span>
						)}
						<span class="action-flow__node-label">{localize(step.label, locale)}</span>
					</div>
					{step.condition && (
						<p class="action-flow__condition action-flow__condition--applies">
							<em>
								{step.kind === 'sequence' ? labels.appliesWhen : ''}{' '}
								{localize(step.condition, locale)}
							</em>
						</p>
					)}
					{step.body && <p class="action-flow__body">{localize(step.body, locale)}</p>}
					{step.children && step.children.length > 0 && (
						<div class="action-flow__branches">
							{step.children.map((branch) => (
								<div class="action-flow__branch">
									<button
										type="button"
										class="action-flow__pick"
										data-pick-id={branch.id}
										data-body={localize(branch.body, locale)}
										data-condition={localize(branch.condition, locale)}
										data-learn-hash={branch.learnMoreHash ?? step.learnMoreHash ?? ''}
									>
										{localize(branch.label, locale)}
									</button>
									{branch.children?.map((sub) => (
										<button
											type="button"
											class="action-flow__pick action-flow__pick--sub"
											data-pick-id={sub.id}
											data-body={localize(sub.body, locale)}
											data-learn-hash={sub.learnMoreHash ?? branch.learnMoreHash ?? ''}
										>
											{localize(sub.label, locale)}
										</button>
									))}
								</div>
							))}
						</div>
					)}
					{step.learnMoreHash && (
						<a
							class="action-flow__learn-more"
							href={`${roundOverviewUrl}#${step.learnMoreHash}`}
							target="_blank"
							rel="noopener"
						>
							{labels.readMore}
						</a>
					)}
				</li>
			))}
		</ol>
	)}
</div>

<script>
	const AUTUMN_STONE_KEY = 'kismeta-autumn-stone';

	type StonePicker = 'all' | 'stasis' | 'forgingNew' | 'forgingReady' | 'notInForge';

	function getGuidedGameMode(): 'quickplay' | 'standard' | 'magnus' {
		const raw = localStorage.getItem('kismeta-guided-progress');
		if (raw) {
			try {
				const data = JSON.parse(raw);
				if (['quickplay', 'standard', 'magnus'].includes(data.mode)) {
					return data.mode;
				}
			} catch {
				/* ignore */
			}
		}
		const modes = localStorage.getItem('kismeta-game-modes');
		if (modes) {
			try {
				const { quickplay, magnus } = JSON.parse(modes);
				if (quickplay && !magnus) return 'quickplay';
				if (magnus && !quickplay) return 'magnus';
			} catch {
				/* ignore */
			}
		}
		return 'standard';
	}

	function loadAutumnStone(): StonePicker {
		const saved = sessionStorage.getItem(AUTUMN_STONE_KEY);
		if (
			saved === 'stasis' ||
			saved === 'forgingNew' ||
			saved === 'forgingReady' ||
			saved === 'notInForge' ||
			saved === 'all'
		) {
			return saved;
		}
		return 'all';
	}

	function stepMatchesStone(statesAttr: string, selected: StonePicker): boolean {
		if (selected === 'all') return true;
		const states = statesAttr.split(/\s+/).filter(Boolean);
		return states.includes('all') || states.includes(selected);
	}

	/** Pass sections to dim when this stone state is selected */
	const PASS_MUTE_BY_STONE: Record<StonePicker, string[]> = {
		all: [],
		stasis: ['pass-2'],
		forgingNew: [],
		forgingReady: [],
		notInForge: [],
	};

	function passHasMatchingStep(passEl: HTMLElement, selected: StonePicker): boolean {
		if (selected === 'all') return true;
		const steps = passEl.querySelectorAll<HTMLElement>('[data-stone-states]');
		for (const step of steps) {
			if (stepMatchesStone(step.dataset.stoneStates || 'all', selected)) return true;
		}
		return false;
	}

	function applyAutumnStone(root: HTMLElement, selected: StonePicker) {
		const mutedPasses = new Set(PASS_MUTE_BY_STONE[selected] ?? []);

		root.querySelectorAll<HTMLElement>('.action-flow__pass').forEach((passEl) => {
			const passId = passEl.dataset.passId || '';
			const forceMute = mutedPasses.has(passId);
			const passMatches = !forceMute && passHasMatchingStep(passEl, selected);
			const passSkip = passEl.querySelector<HTMLElement>('[data-pass-skip-note]');

			if (selected === 'all') {
				passEl.classList.remove('action-flow__pass--muted', 'action-flow__pass--active');
				if (passSkip) passSkip.hidden = true;
			} else {
				passEl.classList.toggle('action-flow__pass--muted', forceMute || !passMatches);
				passEl.classList.toggle('action-flow__pass--active', passMatches && !forceMute);
				if (passSkip) passSkip.hidden = passMatches && !forceMute;
			}
		});

		root.querySelectorAll<HTMLElement>('[data-stone-states]').forEach((step) => {
			const attr = step.dataset.stoneStates || 'all';
			const matches = stepMatchesStone(attr, selected);
			const skipNote = step.querySelector<HTMLElement>('[data-skip-note]');
			const passMuted = step.closest('.action-flow__pass--muted') !== null;

			if (selected === 'all' || passMuted) {
				step.classList.remove(
					'action-flow__procession-step--active',
					'action-flow__procession-step--muted'
				);
				if (skipNote) skipNote.hidden = true;
			} else {
				step.classList.toggle('action-flow__procession-step--active', matches);
				step.classList.toggle('action-flow__procession-step--muted', !matches);
				if (skipNote) skipNote.hidden = matches;
			}
		});

		root.querySelectorAll<HTMLButtonElement>('[data-stone]').forEach((btn) => {
			const isActive = btn.dataset.stone === selected;
			btn.classList.toggle('action-flow__stone-segment--active', isActive);
			btn.setAttribute('aria-pressed', String(isActive));
		});
	}

	function initAutumnStonePicker(root: HTMLElement) {
		const picker = root.querySelector('[data-stone-picker]');
		if (!picker) return;

		let selected = loadAutumnStone();
		applyAutumnStone(root, selected);

		picker.querySelectorAll<HTMLButtonElement>('[data-stone]').forEach((btn) => {
			btn.addEventListener('click', () => {
				const stone = btn.dataset.stone as StonePicker;
				if (!stone) return;
				selected = stone;
				sessionStorage.setItem(AUTUMN_STONE_KEY, stone);
				applyAutumnStone(root, selected);
			});
		});
	}

	function initActionFlowGuides() {
		document.querySelectorAll<HTMLElement>('.action-flow--interactive').forEach((root) => {
			if (root.dataset.bound === 'true') return;
			root.dataset.bound = 'true';

			const labels = JSON.parse(root.dataset.labels || '{}') as {
				readMore?: string;
			};
			const learnBase = root.dataset.learnBase || '';
			const learnPath = root.dataset.learnPath || 'play/round-overview';

			if (root.classList.contains('action-flow--autumn')) {
				initAutumnStonePicker(root);
			}

			const showDetail = (btn: HTMLButtonElement) => {
				root.querySelectorAll('.action-flow__pick--active').forEach((el) => {
					el.classList.remove('action-flow__pick--active');
				});
				btn.classList.add('action-flow__pick--active');

				const body = btn.dataset.body || '';
				const condition = btn.dataset.condition || '';
				const learnHash = btn.dataset.learnHash || '';
				let modeNotes: Record<string, string | null> = {};
				try {
					modeNotes = JSON.parse(btn.dataset.modeNotes || '{}');
				} catch {
					/* ignore */
				}

				const mode = getGuidedGameMode();
				const modeNote = modeNotes[mode] ?? '';
				const learnHref = learnHash ? `${learnBase}#${learnHash}` : learnBase;

				window.dispatchEvent(
					new CustomEvent('kismeta:action-detail', {
						detail: {
							body: body || btn.textContent?.trim() || '',
							condition,
							modeNote,
							learnHref,
							learnLabel: labels.readMore || 'Read full rules',
							visible: true,
						},
					})
				);

				window.dispatchEvent(
					new CustomEvent('kismeta:context', {
						detail: { path: learnPath, hash: learnHash },
					})
				);
			};

			root.querySelectorAll<HTMLButtonElement>('.action-flow__pick').forEach((btn) => {
				btn.addEventListener('click', () => showDetail(btn));
			});
		});
	}

	document.addEventListener('astro:page-load', initActionFlowGuides);
	initActionFlowGuides();
</script>
