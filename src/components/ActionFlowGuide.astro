---
import { getRelativeLocaleUrl } from 'astro:i18n';
import {
	getFlow,
	localize,
	type FlowId,
	type FlowNode,
	type StoneState,
} from '../data/content-registry';
import { resolveContentLocale } from '../utils/locale';

interface Props {
	flowId: FlowId;
}

const { flowId } = Astro.props;
const starlightLocale = Astro.currentLocale ?? 'root';
const contentLocale = resolveContentLocale(starlightLocale);
const t = Astro.locals.t;
const flow = getFlow(flowId);
const intro = localize(flow.intro, contentLocale);
const learnPath = 'play/round-overview';
const roundOverviewUrl = getRelativeLocaleUrl(starlightLocale, learnPath);

const isSummer = flow.mode === 'playerTurn';
const isAutumn = flowId === 'autumn-flow';
const isWinter = flowId === 'winter-flow';
const isWizard = isAutumn || isWinter;

const labels = {
	required: t('flow.required'),
	optional: t('flow.optional'),
	choice: t('flow.choice'),
	sequence: t('flow.sequence'),
	appliesWhen: t('flow.appliesWhen'),
	likelySkip: t('flow.likelySkip'),
	readMore: t('flow.readMore'),
	pickPrompt: t('flow.pickPrompt'),
	stonePickerTitle: t('flow.stonePickerTitle'),
	stoneAll: t('flow.stoneAll'),
	stoneStasis: t('flow.stoneStasis'),
	stoneForgingNew: t('flow.stoneForgingNew'),
	stoneForgingReady: t('flow.stoneForgingReady'),
	stoneNotInForge: t('flow.stoneNotInForge'),
	processionLabel: t('flow.processionLabel'),
	passLikelySkip: t('flow.passLikelySkip'),
	wizardBack: t('flow.wizardBack'),
	wizardNext: t('flow.wizardNext'),
	wizardContinue: t('flow.wizardContinue'),
	wizardDone: t('flow.wizardDone'),
	wizardStepOf: t('flow.wizardStepOf'),
	yes: t('flow.yes'),
	noSkip: t('flow.noSkip'),
	autumnDoneMessage: t('flow.autumnDoneMessage'),
	autumnRestartLabel: t('flow.autumnRestartLabel'),
	autumnOppositionPrompt: t('flow.autumnOppositionPrompt'),
	autumnLightCauldronsPrompt: t('flow.autumnLightCauldronsPrompt'),
	autumnTemperPrompt: t('flow.autumnTemperPrompt'),
	autumnFirePrompt: t('flow.autumnFirePrompt'),
	winterWagerPrompt: t('flow.winterWagerPrompt'),
};

// Wizard stone options — the four real states (no "show all")
const wizardStoneOptions: Array<{ id: Exclude<StoneState, 'all'>; label: string }> = [
	{ id: 'stasis', label: labels.stoneStasis },
	{ id: 'forgingNew', label: labels.stoneForgingNew },
	{ id: 'forgingReady', label: labels.stoneForgingReady },
	{ id: 'notInForge', label: labels.stoneNotInForge },
];

function topGroups(node: FlowNode): FlowNode[] {
	return node.children ?? [];
}

const topLevel = isSummer ? topGroups(flow.root) : [flow.root];

// Autumn: extract the specific step nodes used in wizard panels
const autumnPass1 = isAutumn
	? (flow.root.children ?? []).find((n) => n.id === 'pass-1') ?? null
	: null;
const autumnPass2 = isAutumn
	? (flow.root.children ?? []).find((n) => n.id === 'pass-2') ?? null
	: null;
const leaveStasisNode = autumnPass1?.children?.find((n) => n.id === 'leave-stasis') ?? null;
const oppositionNode = autumnPass1?.children?.find((n) => n.id === 'opposition') ?? null;
const lightCauldronsNode = autumnPass2?.children?.find((n) => n.id === 'light-cauldrons') ?? null;
const temperNode = autumnPass2?.children?.find((n) => n.id === 'temper') ?? null;
const fireNode = autumnPass2?.children?.find((n) => n.id === 'fire') ?? null;

// Winter: extract the specific step nodes used in wizard panels
const winterChildren = isWinter ? (flow.root.children ?? []) : [];
const unlockNode = winterChildren.find((n) => n.id === 'unlock') ?? null;
const wagerNode = winterChildren.find((n) => n.id === 'wager') ?? null;
const limitsNode = winterChildren.find((n) => n.id === 'limits') ?? null;
const resetNode = winterChildren.find((n) => n.id === 'transit') ?? null;
---

<div
	class:list={[
		'action-flow',
		'action-flow--interactive',
		{ 'action-flow--autumn': isAutumn, 'action-flow--winter': isWinter },
	]}
	data-flow-id={flowId}
	data-flow-mode={flow.mode}
	data-locale={contentLocale}
	data-learn-base={roundOverviewUrl}
	data-learn-path={learnPath}
	data-labels={JSON.stringify(labels)}
>
	{intro && <p class="action-flow__intro">{intro}</p>}

	{!isWizard && <p class="action-flow__hint">{labels.pickPrompt}</p>}

	{isSummer ? (
		<div class="action-flow__summer" data-summer-root>
			<div class="action-flow__groups" role="group" aria-label={localize(flow.root.label, contentLocale)}>
				{topLevel.map((group) => (
					<div class="action-flow__group" data-group-id={group.id}>
						<h3 class="action-flow__group-title">{localize(group.label, contentLocale)}</h3>
						<div class="action-flow__group-actions">
							{(group.children ?? []).map((action) => (
								<button
									type="button"
									class="action-flow__pick"
									data-pick-id={action.id}
									data-body={localize(action.body, contentLocale)}
									data-condition={localize(action.condition, contentLocale)}
									data-learn-hash={action.learnMoreHash ?? ''}
									data-mode-notes={JSON.stringify(action.gameModeNote ?? {})}
								>
									{localize(action.label, contentLocale)}
								</button>
							))}
						</div>
					</div>
				))}
			</div>
		</div>
	) : (
		<div class="action-flow__wizard" data-flow-wizard>
			<div class="action-flow__wizard-progress" data-wizard-progress aria-live="polite"></div>

			{/* ── Autumn wizard panels ─────────────────────────────────── */}
			{isAutumn && (
				<>
				{/* Panel 1: Stone state picker */}
				<div class="action-flow__wizard-panel" data-wizard-panel="autumn-stone-pick" data-learn-hash="conduct-the-great-work" hidden>
						<p class="action-flow__wizard-stone-title">{labels.stonePickerTitle}</p>
						<div class="action-flow__wizard-stone-options">
							{wizardStoneOptions.map((opt) => (
								<button
									type="button"
									class="action-flow__wizard-stone-btn"
									aria-pressed="false"
									data-wizard-stone={opt.id}
								>
									{opt.label}
								</button>
							))}
						</div>
					</div>

					{/* Panel: Leave Stasis — only shown for stasis stone */}
					{leaveStasisNode && (
						<div class="action-flow__wizard-panel" data-wizard-panel="autumn-leave-stasis" data-learn-hash={leaveStasisNode.learnMoreHash ?? ''} hidden>
							<div class="action-flow__wizard-step-head">
								<span class="action-flow__badge action-flow__badge--sequence">{labels.sequence}</span>
								<span class="action-flow__wizard-step-label">
									{localize(leaveStasisNode.label, contentLocale)}
								</span>
							</div>
							{leaveStasisNode.condition && (
								<p class="action-flow__wizard-step-condition">
									<em>
										{labels.appliesWhen} {localize(leaveStasisNode.condition, contentLocale)}
									</em>
								</p>
							)}
							{leaveStasisNode.children && leaveStasisNode.children.length > 0 && (
								<div class="action-flow__branches">
									{leaveStasisNode.children.map((branch) => (
										<div class="action-flow__branch">
											<button
												type="button"
												class="action-flow__pick"
												data-pick-id={branch.id}
												data-body={localize(branch.body, contentLocale)}
												data-condition={localize(branch.condition, contentLocale)}
												data-learn-hash={branch.learnMoreHash ?? leaveStasisNode.learnMoreHash ?? ''}
											>
												{localize(branch.label, contentLocale)}
											</button>
											{branch.children?.map((sub) => (
												<button
													type="button"
													class="action-flow__pick action-flow__pick--sub"
													data-pick-id={sub.id}
													data-body={localize(sub.body, contentLocale)}
													data-learn-hash={
														sub.learnMoreHash ??
														branch.learnMoreHash ??
														leaveStasisNode.learnMoreHash ??
														''
													}
												>
													{localize(sub.label, contentLocale)}
												</button>
											))}
										</div>
									))}
								</div>
							)}
							{leaveStasisNode.learnMoreHash && (
								<a
									class="action-flow__learn-more"
									href={`${roundOverviewUrl}#${leaveStasisNode.learnMoreHash}`}
									target="_blank"
									rel="noopener"
								>
									{labels.readMore}
								</a>
							)}
						</div>
					)}

					{/* Panel: Light Cauldrons gate — only shown for notInForge */}
					{lightCauldronsNode && (
						<div
							class="action-flow__wizard-panel"
							data-wizard-panel="autumn-light-cauldrons-gate"
							data-wizard-panel-type="gate"
							data-gate-prompt={labels.autumnLightCauldronsPrompt}
							data-learn-hash={lightCauldronsNode.learnMoreHash ?? ''}
							hidden
						>
							<div class="action-flow__wizard-step-head">
								<span class="action-flow__badge action-flow__badge--sequence">{labels.sequence}</span>
								<span class="action-flow__wizard-step-label">
									{localize(lightCauldronsNode.label, contentLocale)}
								</span>
							</div>
							{lightCauldronsNode.condition && (
								<p class="action-flow__wizard-step-condition">
									<em>
										{labels.appliesWhen} {localize(lightCauldronsNode.condition, contentLocale)}
									</em>
								</p>
							)}
							<div class="action-flow__wizard-gate-content" data-wizard-gate-content hidden>
								{lightCauldronsNode.body && (
									<p class="action-flow__wizard-step-body">
										{localize(lightCauldronsNode.body, contentLocale)}
									</p>
								)}
								{lightCauldronsNode.learnMoreHash && (
									<a
										class="action-flow__learn-more"
										href={`${roundOverviewUrl}#${lightCauldronsNode.learnMoreHash}`}
										target="_blank"
										rel="noopener"
									>
										{labels.readMore}
									</a>
								)}
							</div>
						</div>
					)}

					{/* Panel: Opposition gate — shown for all stone states */}
					{oppositionNode && (
						<div
							class="action-flow__wizard-panel"
							data-wizard-panel="autumn-opposition-gate"
							data-wizard-panel-type="gate"
							data-gate-prompt={labels.autumnOppositionPrompt}
							data-learn-hash={oppositionNode.learnMoreHash ?? ''}
							hidden
						>
							<div class="action-flow__wizard-step-head">
								<span class="action-flow__badge action-flow__badge--sequence">{labels.sequence}</span>
								<span class="action-flow__wizard-step-label">
									{localize(oppositionNode.label, contentLocale)}
								</span>
							</div>
							{oppositionNode.condition && (
								<p class="action-flow__wizard-step-condition">
									<em>
										{labels.appliesWhen} {localize(oppositionNode.condition, contentLocale)}
									</em>
								</p>
							)}
							<div class="action-flow__wizard-gate-content" data-wizard-gate-content hidden>
								{oppositionNode.body && (
									<p class="action-flow__wizard-step-body">
										{localize(oppositionNode.body, contentLocale)}
									</p>
								)}
								{oppositionNode.learnMoreHash && (
									<a
										class="action-flow__learn-more"
										href={`${roundOverviewUrl}#${oppositionNode.learnMoreHash}`}
										target="_blank"
										rel="noopener"
									>
										{labels.readMore}
									</a>
								)}
							</div>
						</div>
					)}

					{/* Panel: Temper gate — only shown for forgingReady */}
					{temperNode && (
						<div
							class="action-flow__wizard-panel"
							data-wizard-panel="autumn-temper-gate"
							data-wizard-panel-type="gate"
							data-gate-prompt={labels.autumnTemperPrompt}
							data-learn-hash={temperNode.learnMoreHash ?? ''}
							hidden
						>
							<div class="action-flow__wizard-step-head">
								<span class="action-flow__badge action-flow__badge--sequence">{labels.sequence}</span>
								<span class="action-flow__wizard-step-label">
									{localize(temperNode.label, contentLocale)}
								</span>
							</div>
							{temperNode.condition && (
								<p class="action-flow__wizard-step-condition">
									<em>
										{labels.appliesWhen} {localize(temperNode.condition, contentLocale)}
									</em>
								</p>
							)}
							<div class="action-flow__wizard-gate-content" data-wizard-gate-content hidden>
								{temperNode.body && (
									<p class="action-flow__wizard-step-body">
										{localize(temperNode.body, contentLocale)}
									</p>
								)}
								{temperNode.learnMoreHash && (
									<a
										class="action-flow__learn-more"
										href={`${roundOverviewUrl}#${temperNode.learnMoreHash}`}
										target="_blank"
										rel="noopener"
									>
										{labels.readMore}
									</a>
								)}
							</div>
						</div>
					)}

					{/* Panel: Fire gate — only shown for forgingNew / notInForge */}
					{fireNode && (
						<div
							class="action-flow__wizard-panel"
							data-wizard-panel="autumn-fire-gate"
							data-wizard-panel-type="gate"
							data-gate-prompt={labels.autumnFirePrompt}
							data-learn-hash={fireNode.learnMoreHash ?? ''}
							hidden
						>
							<div class="action-flow__wizard-step-head">
								<span class="action-flow__badge action-flow__badge--sequence">{labels.sequence}</span>
								<span class="action-flow__wizard-step-label">
									{localize(fireNode.label, contentLocale)}
								</span>
							</div>
							{fireNode.condition && (
								<p class="action-flow__wizard-step-condition">
									<em>
										{labels.appliesWhen} {localize(fireNode.condition, contentLocale)}
									</em>
								</p>
							)}
							<div class="action-flow__wizard-gate-content" data-wizard-gate-content hidden>
								{fireNode.body && (
									<p class="action-flow__wizard-step-body">
										{localize(fireNode.body, contentLocale)}
									</p>
								)}
								{fireNode.learnMoreHash && (
									<a
										class="action-flow__learn-more"
										href={`${roundOverviewUrl}#${fireNode.learnMoreHash}`}
										target="_blank"
										rel="noopener"
									>
										{labels.readMore}
									</a>
								)}
							</div>
						</div>
					)}

				{/* Panel: Done */}
				<div
					class="action-flow__wizard-panel action-flow__wizard-panel--done"
					data-wizard-panel="autumn-done"
					data-learn-hash="conduct-the-great-work"
					hidden
				>
						<p class="action-flow__wizard-done-message">{labels.autumnDoneMessage}</p>
						<button type="button" class="action-flow__wizard-restart" data-wizard-restart>
							{labels.autumnRestartLabel}
						</button>
					</div>
				</>
			)}

			{/* ── Winter wizard panels ─────────────────────────────────── */}
			{isWinter && (
				<>
					{/* Panel 1: Card Unlock — required */}
					{unlockNode && (
						<div class="action-flow__wizard-panel" data-wizard-panel="winter-unlock" data-learn-hash={unlockNode.learnMoreHash ?? ''} hidden>
							<div class="action-flow__wizard-step-head">
								<span class="action-flow__badge action-flow__badge--required">{labels.required}</span>
								<span class="action-flow__wizard-step-label">
									{localize(unlockNode.label, contentLocale)}
								</span>
							</div>
							{unlockNode.body && (
								<p class="action-flow__wizard-step-body">
									{localize(unlockNode.body, contentLocale)}
								</p>
							)}
							{unlockNode.learnMoreHash && (
								<a
									class="action-flow__learn-more"
									href={`${roundOverviewUrl}#${unlockNode.learnMoreHash}`}
									target="_blank"
									rel="noopener"
								>
									{labels.readMore}
								</a>
							)}
						</div>
					)}

					{/* Panel: Fateful Wager — optional gate */}
					{wagerNode && (
						<div
							class="action-flow__wizard-panel"
							data-wizard-panel="winter-wager-gate"
							data-wizard-panel-type="gate"
							data-gate-prompt={labels.winterWagerPrompt}
							data-learn-hash={wagerNode.learnMoreHash ?? ''}
							hidden
						>
							<div class="action-flow__wizard-step-head">
								<span class="action-flow__badge action-flow__badge--optional">{labels.optional}</span>
								<span class="action-flow__wizard-step-label">
									{localize(wagerNode.label, contentLocale)}
								</span>
							</div>
							<div class="action-flow__wizard-gate-content" data-wizard-gate-content hidden>
								{wagerNode.body && (
									<p class="action-flow__wizard-step-body">
										{localize(wagerNode.body, contentLocale)}
									</p>
								)}
								{wagerNode.learnMoreHash && (
									<a
										class="action-flow__learn-more"
										href={`${roundOverviewUrl}#${wagerNode.learnMoreHash}`}
										target="_blank"
										rel="noopener"
									>
										{labels.readMore}
									</a>
								)}
							</div>
						</div>
					)}

					{/* Panel: Enforce Card Limits — required */}
					{limitsNode && (
						<div class="action-flow__wizard-panel" data-wizard-panel="winter-limits" data-learn-hash={limitsNode.learnMoreHash ?? ''} hidden>
							<div class="action-flow__wizard-step-head">
								<span class="action-flow__badge action-flow__badge--required">{labels.required}</span>
								<span class="action-flow__wizard-step-label">
									{localize(limitsNode.label, contentLocale)}
								</span>
							</div>
							{limitsNode.body && (
								<p class="action-flow__wizard-step-body">
									{localize(limitsNode.body, contentLocale)}
								</p>
							)}
							{limitsNode.learnMoreHash && (
								<a
									class="action-flow__learn-more"
									href={`${roundOverviewUrl}#${limitsNode.learnMoreHash}`}
									target="_blank"
									rel="noopener"
								>
									{labels.readMore}
								</a>
							)}
						</div>
					)}

					{/* Panel: Reset & Pass Key — required, last */}
					{resetNode && (
						<div class="action-flow__wizard-panel" data-wizard-panel="winter-reset" data-learn-hash={resetNode.learnMoreHash ?? ''} hidden>
							<div class="action-flow__wizard-step-head">
								<span class="action-flow__badge action-flow__badge--required">{labels.required}</span>
								<span class="action-flow__wizard-step-label">
									{localize(resetNode.label, contentLocale)}
								</span>
							</div>
							{resetNode.body && (
								<p class="action-flow__wizard-step-body">
									{localize(resetNode.body, contentLocale)}
								</p>
							)}
							{resetNode.learnMoreHash && (
								<a
									class="action-flow__learn-more"
									href={`${roundOverviewUrl}#${resetNode.learnMoreHash}`}
									target="_blank"
									rel="noopener"
								>
									{labels.readMore}
								</a>
							)}
						</div>
					)}
				</>
			)}

		{/* ── Gate decision (question + Yes/No) ─────────────────────── */}
		<div class="action-flow__wizard-gate" data-wizard-gate hidden>
			<p class="action-flow__wizard-gate-question" data-wizard-gate-question></p>
			<div class="action-flow__wizard-gate-actions">
				<button
					type="button"
					class="action-flow__wizard-btn action-flow__wizard-btn--gate-no"
					data-wizard-gate-no
				>
					{labels.noSkip}
				</button>
				<button
					type="button"
					class="action-flow__wizard-btn action-flow__wizard-btn--gate-yes"
					data-wizard-gate-yes
				>
					{labels.yes}
				</button>
			</div>
		</div>

		{/* ── Shared wizard navigation ─────────────────────────────── */}
		<div class="action-flow__wizard-nav" data-wizard-nav hidden>
			<button
				type="button"
				class="action-flow__wizard-btn action-flow__wizard-btn--back"
				data-wizard-back
				hidden
			>
				{labels.wizardBack}
			</button>
			<div class="action-flow__wizard-next-preview" data-wizard-next-preview hidden>
				<span class="action-flow__wizard-next-label">{labels.wizardNext}</span>
				<span class="action-flow__wizard-next-title" data-wizard-next-title></span>
			</div>
			<div class="action-flow__wizard-nav-right">
					<button
						type="button"
						class="action-flow__wizard-btn action-flow__wizard-btn--continue"
						data-wizard-continue
						hidden
					>
						{labels.wizardContinue}
					</button>
				</div>
			</div>
		</div>
	)}
</div>

<script>
	// ── Helpers ────────────────────────────────────────────────────────────

	function getGuidedGameMode(): 'quickplay' | 'standard' | 'magnus' {
		const raw = localStorage.getItem('kismeta-guided-progress');
		if (raw) {
			try {
				const data = JSON.parse(raw);
				if (['quickplay', 'standard', 'magnus'].includes(data.mode)) {
					return data.mode;
				}
			} catch {
				/* ignore */
			}
		}
		const modes = localStorage.getItem('kismeta-game-modes');
		if (modes) {
			try {
				const { quickplay, magnus } = JSON.parse(modes);
				if (quickplay && !magnus) return 'quickplay';
				if (magnus && !quickplay) return 'magnus';
			} catch {
				/* ignore */
			}
		}
		return 'standard';
	}

	// ── Wizard state types & storage ───────────────────────────────────────

	const AUTUMN_WIZARD_KEY = 'kismeta-autumn-wizard';
	const WINTER_WIZARD_KEY = 'kismeta-winter-wizard';

	type AutumnStone = 'stasis' | 'forgingNew' | 'forgingReady' | 'notInForge';

	interface AutumnWizardState {
		stone: AutumnStone | null;
		index: number;
		gateAnswers: Record<string, boolean>;
	}

	interface WinterWizardState {
		index: number;
		gateAnswers: Record<string, boolean>;
	}

	const WINTER_SEQUENCE = [
		'winter-unlock',
		'winter-wager-gate',
		'winter-limits',
		'winter-reset',
	];

	function buildAutumnSequence(stone: AutumnStone): string[] {
		const seq: string[] = ['autumn-stone-pick'];
		if (stone === 'stasis') seq.push('autumn-leave-stasis');
		if (stone === 'notInForge') seq.push('autumn-light-cauldrons-gate');
		seq.push('autumn-opposition-gate');
		if (stone !== 'stasis') {
			if (stone === 'forgingReady') seq.push('autumn-temper-gate');
			else seq.push('autumn-fire-gate'); // forgingNew or notInForge
		}
		seq.push('autumn-done');
		return seq;
	}

	function loadAutumnState(): AutumnWizardState {
		try {
			const raw = sessionStorage.getItem(AUTUMN_WIZARD_KEY);
			if (raw) {
				const p = JSON.parse(raw);
				return {
					stone: p.stone ?? null,
					index: typeof p.index === 'number' ? p.index : 0,
					gateAnswers: p.gateAnswers ?? {},
				};
			}
		} catch {
			/* ignore */
		}
		return { stone: null, index: 0, gateAnswers: {} };
	}

	function saveAutumnState(s: AutumnWizardState): void {
		sessionStorage.setItem(AUTUMN_WIZARD_KEY, JSON.stringify(s));
	}

	function loadWinterState(): WinterWizardState {
		try {
			const raw = sessionStorage.getItem(WINTER_WIZARD_KEY);
			if (raw) {
				const p = JSON.parse(raw);
				return {
					index: typeof p.index === 'number' ? p.index : 0,
					gateAnswers: p.gateAnswers ?? {},
				};
			}
		} catch {
			/* ignore */
		}
		return { index: 0, gateAnswers: {} };
	}

	function saveWinterState(s: WinterWizardState): void {
		sessionStorage.setItem(WINTER_WIZARD_KEY, JSON.stringify(s));
	}

	// ── Wizard initialiser ─────────────────────────────────────────────────

	function initWizard(root: HTMLElement): void {
		const isAutumn = root.classList.contains('action-flow--autumn');
		const wizardEl = root.querySelector<HTMLElement>('[data-flow-wizard]');
		if (!wizardEl) return;

		const progressEl = wizardEl.querySelector<HTMLElement>('[data-wizard-progress]');
		const gateEl = wizardEl.querySelector<HTMLElement>('[data-wizard-gate]');
		const gateQuestionEl = wizardEl.querySelector<HTMLElement>('[data-wizard-gate-question]');
		const navEl = wizardEl.querySelector<HTMLElement>('[data-wizard-nav]');
		const backBtn = wizardEl.querySelector<HTMLButtonElement>('[data-wizard-back]');
		const continueBtn = wizardEl.querySelector<HTMLButtonElement>('[data-wizard-continue]');
		const gateYesBtn = wizardEl.querySelector<HTMLButtonElement>('[data-wizard-gate-yes]');
		const gateNoBtn = wizardEl.querySelector<HTMLButtonElement>('[data-wizard-gate-no]');
		const nextPreviewEl = wizardEl.querySelector<HTMLElement>('[data-wizard-next-preview]');
		const nextTitleEl = wizardEl.querySelector<HTMLElement>('[data-wizard-next-title]');

		if (!navEl || !backBtn || !continueBtn || !gateYesBtn || !gateNoBtn) return;

		const labels = JSON.parse(root.dataset.labels || '{}') as {
			readMore?: string;
			wizardContinue?: string;
			wizardDone?: string;
			wizardStepOf?: string;
		};

		let autumnState: AutumnWizardState = { stone: null, index: 0, gateAnswers: {} };
		let winterState: WinterWizardState = { index: 0, gateAnswers: {} };
		let sequence: string[] = [];

		if (isAutumn) {
			autumnState = loadAutumnState();
			sequence = autumnState.stone
				? buildAutumnSequence(autumnState.stone)
				: ['autumn-stone-pick'];
		} else {
			winterState = loadWinterState();
			sequence = [...WINTER_SEQUENCE];
		}

		function getState(): { index: number; gateAnswers: Record<string, boolean> } {
			return isAutumn ? autumnState : winterState;
		}

		function saveState(): void {
			if (isAutumn) saveAutumnState(autumnState);
			else saveWinterState(winterState);
		}

		function getPanelEl(panelId: string): HTMLElement | null {
			return wizardEl!.querySelector<HTMLElement>(`[data-wizard-panel="${panelId}"]`);
		}

		function isGatePanel(panelId: string): boolean {
			return getPanelEl(panelId)?.dataset.wizardPanelType === 'gate';
		}

		function updateNav(panelId: string, index: number): void {
			const isStone = panelId === 'autumn-stone-pick';
			const isDone = panelId === 'autumn-done';
			const isFirst = index === 0;
			const isLast = index === sequence.length - 1;
			const isGate = isGatePanel(panelId);
			const gateAnswer = getState().gateAnswers[panelId];
			const gateUnanswered = isGate && gateAnswer === undefined;
			const panelEl = getPanelEl(panelId);

			if (gateEl) {
				gateEl.hidden = isStone || isDone || !gateUnanswered;
				if (gateUnanswered && gateQuestionEl && panelEl) {
					gateQuestionEl.textContent = panelEl.dataset.gatePrompt ?? '';
				}
			}

			navEl!.hidden = isStone;
			if (isStone) return;

			backBtn!.hidden = isFirst;

			if (isDone || gateUnanswered) {
				continueBtn!.hidden = true;
			} else {
				continueBtn!.hidden = false;
				continueBtn!.textContent = isLast
					? (labels.wizardDone || 'Done')
					: (labels.wizardContinue || 'Continue');
			}

			// Next step preview label — hidden while a gate question is unanswered
			if (nextPreviewEl && nextTitleEl) {
				const hasNext = !isLast && !isDone && !gateUnanswered;
				if (hasNext) {
					const nextPanelId = sequence[index + 1];
					const nextPanelEl = getPanelEl(nextPanelId);
					const nextLabel =
						nextPanelEl?.querySelector('.action-flow__wizard-step-label')?.textContent?.trim() ?? '';
					if (nextLabel) {
						nextTitleEl.textContent = nextLabel;
						nextPreviewEl.hidden = false;
					} else {
						nextPreviewEl.hidden = true;
					}
				} else {
					nextPreviewEl.hidden = true;
				}
			}
		}

	function showPanel(panelId: string, index: number, moveFocus = false): void {
		// Hide every panel
		wizardEl!.querySelectorAll<HTMLElement>('[data-wizard-panel]').forEach((p) => {
			p.hidden = true;
		});

		// Reveal the active panel
		const panelEl = getPanelEl(panelId);
		if (panelEl) {
			panelEl.hidden = false;

			// When triggered by user interaction (not initial load), move focus
			// into the new panel so keyboard users don't have to re-Tab past nav.
			if (moveFocus) {
				const gateUnanswered =
					isGatePanel(panelId) && getState().gateAnswers[panelId] === undefined;
				const focusTarget = gateUnanswered && gateQuestionEl
					? gateQuestionEl
					: panelEl.querySelector<HTMLElement>(
							'.action-flow__wizard-step-label, .action-flow__wizard-stone-title'
						);
				if (focusTarget) {
					focusTarget.setAttribute('tabindex', '-1');
					focusTarget.focus();
				}
			}

				// Gate content visibility reflects the stored answer
				if (isGatePanel(panelId)) {
					const gateContent = panelEl.querySelector<HTMLElement>('[data-wizard-gate-content]');
					if (gateContent) {
						gateContent.hidden = getState().gateAnswers[panelId] !== true;
					}
				}

				// Highlight the previously-chosen stone when returning to the picker
				if (panelId === 'autumn-stone-pick' && autumnState.stone) {
					panelEl.querySelectorAll<HTMLButtonElement>('[data-wizard-stone]').forEach((btn) => {
						const active = btn.dataset.wizardStone === autumnState.stone;
						btn.classList.toggle('action-flow__wizard-stone-btn--active', active);
						btn.setAttribute('aria-pressed', String(active));
					});
				}
			}

			// Progress indicator
			if (progressEl) {
				if (panelId === 'autumn-stone-pick') {
					progressEl.textContent = '';
				} else {
					const tpl = labels.wizardStepOf || '{current} of {total}';
					progressEl.textContent = tpl
						.replace('{current}', String(index + 1))
						.replace('{total}', String(sequence.length));
				}
			}

			updateNav(panelId, index);

			// Update the aside context for this panel's rules section
			const learnHash = panelEl?.dataset.learnHash ?? '';
			const learnPath = root.dataset.learnPath || 'play/round-overview';
			window.dispatchEvent(
				new CustomEvent('kismeta:context', {
					detail: { path: learnPath, hash: learnHash },
				})
			);
		}

	function navigate(delta: number): void {
		const state = getState();
		const targetIndex = state.index + delta;
		if (targetIndex < 0 || targetIndex >= sequence.length) return;

		// Navigating Back through a gate resets it so the player can re-answer
		if (delta < 0) {
			const targetPanel = sequence[targetIndex];
			if (isGatePanel(targetPanel)) {
				delete state.gateAnswers[targetPanel];
			}
		}

		state.index = targetIndex;
		saveState();
		showPanel(sequence[targetIndex], targetIndex, true);
	}

		// Back
		backBtn.addEventListener('click', () => navigate(-1));

		// Continue / Done
		continueBtn.addEventListener('click', () => {
			const state = getState();
			if (state.index < sequence.length - 1) {
				navigate(1);
			} else if (!isAutumn) {
				// Winter: clear session so returning later starts fresh, then advance the outer stepper
				sessionStorage.removeItem(WINTER_WIZARD_KEY);
				window.dispatchEvent(new CustomEvent('kismeta:guided-advance'));
			}
		});

		// Gate Yes — reveal content in current panel, switch to Continue
		gateYesBtn.addEventListener('click', () => {
			const state = getState();
			const panelId = sequence[state.index];
			state.gateAnswers[panelId] = true;
			saveState();

			const panelEl = getPanelEl(panelId);
			const gateContent = panelEl?.querySelector<HTMLElement>('[data-wizard-gate-content]');
			if (gateContent) gateContent.hidden = false;

			updateNav(panelId, state.index);
		});

		// Gate No — store answer and advance to the next panel
		gateNoBtn.addEventListener('click', () => {
			const state = getState();
			const panelId = sequence[state.index];
			state.gateAnswers[panelId] = false;
			saveState();
			navigate(1);
		});

		// Stone selection (autumn only) — rebuilds sequence and advances
		if (isAutumn) {
			wizardEl.querySelectorAll<HTMLButtonElement>('[data-wizard-stone]').forEach((btn) => {
				btn.addEventListener('click', () => {
					const stone = btn.dataset.wizardStone as AutumnStone;
					if (!stone) return;

					autumnState.stone = stone;
					autumnState.gateAnswers = {};
					sequence = buildAutumnSequence(stone);
					autumnState.index = 1;
					saveAutumnState(autumnState);

				// Highlight selection
				wizardEl!
						.querySelectorAll<HTMLButtonElement>('[data-wizard-stone]')
						.forEach((b) => {
							const active = b === btn;
							b.classList.toggle('action-flow__wizard-stone-btn--active', active);
							b.setAttribute('aria-pressed', String(active));
						});

					showPanel(sequence[1], 1, true);
				});
			});

			// "Change stone state" restart button on the done panel
			const restartBtn = wizardEl.querySelector<HTMLButtonElement>('[data-wizard-restart]');
			if (restartBtn) {
				restartBtn.addEventListener('click', () => {
					autumnState.stone = null;
					autumnState.index = 0;
					autumnState.gateAnswers = {};
					sequence = ['autumn-stone-pick'];
					saveAutumnState(autumnState);

				wizardEl!
					.querySelectorAll<HTMLButtonElement>('[data-wizard-stone]')
					.forEach((b) => {
						b.classList.remove('action-flow__wizard-stone-btn--active');
						b.setAttribute('aria-pressed', 'false');
					});

				showPanel('autumn-stone-pick', 0, true);
				});
			}
		}

	// Restore from session storage — clamp index in case sequence length changed
	const initialState = getState();
	initialState.index = Math.min(initialState.index, sequence.length - 1);
	showPanel(sequence[initialState.index], initialState.index);

	// Re-dispatch the active panel's context whenever the guided stepper
	// re-renders its step (which briefly overwrites the panel-specific context
	// with the generic phase hash). Only reassert when this wizard is visible.
	window.addEventListener('kismeta:wizard-refocus', () => {
		const embedPanel = root.closest<HTMLElement>('[data-embed-panel]');
		if (!embedPanel || embedPanel.hidden) return;
		const state = getState();
		showPanel(sequence[state.index], state.index);
	});
}

	// ── Action-detail dispatch (branch pick buttons) ───────────────────────

	function initActionFlowGuides() {
		document.querySelectorAll<HTMLElement>('.action-flow--interactive').forEach((root) => {
			if (root.dataset.bound === 'true') return;
			root.dataset.bound = 'true';

			const labels = JSON.parse(root.dataset.labels || '{}') as {
				readMore?: string;
			};
			const learnBase = root.dataset.learnBase || '';
			const learnPath = root.dataset.learnPath || 'play/round-overview';

			if (
				root.classList.contains('action-flow--autumn') ||
				root.classList.contains('action-flow--winter')
			) {
				initWizard(root);
			}

			const showDetail = (btn: HTMLButtonElement) => {
				root.querySelectorAll('.action-flow__pick--active').forEach((el) => {
					el.classList.remove('action-flow__pick--active');
				});
				btn.classList.add('action-flow__pick--active');

				const body = btn.dataset.body || '';
				const condition = btn.dataset.condition || '';
				const learnHash = btn.dataset.learnHash || '';
				let modeNotes: Record<string, string | null> = {};
				try {
					modeNotes = JSON.parse(btn.dataset.modeNotes || '{}');
				} catch {
					/* ignore */
				}

				const mode = getGuidedGameMode();
				const modeNote = modeNotes[mode] ?? '';
				const learnHref = learnHash ? `${learnBase}#${learnHash}` : learnBase;

				window.dispatchEvent(
					new CustomEvent('kismeta:action-detail', {
						detail: {
							title: btn.textContent?.trim() || '',
							body: body || btn.textContent?.trim() || '',
							condition,
							modeNote,
							learnHref,
							learnLabel: labels.readMore || 'Read full rules',
							visible: true,
						},
					})
				);

				window.dispatchEvent(
					new CustomEvent('kismeta:context', {
						detail: { path: learnPath, hash: learnHash },
					})
				);
			};

			root.querySelectorAll<HTMLButtonElement>('.action-flow__pick').forEach((btn) => {
				btn.addEventListener('click', () => showDetail(btn));
			});
		});
	}

	document.addEventListener('astro:page-load', initActionFlowGuides);
	initActionFlowGuides();
</script>
