---
import { getContextSectionIndex } from '../data/context-sections';
import { resolveContentLocale } from '../utils/locale';

const locale = resolveContentLocale(Astro.currentLocale);
const t = Astro.locals.t;
const sections = getContextSectionIndex(locale);

const labels = {
	title: t('guided.context.title'),
	empty: t('guided.context.empty'),
	openFull: t('guided.context.openFull'),
	close: t('guided.context.close'),
};
---

<div
	class="context-rules-panel"
	data-sections={JSON.stringify(sections)}
	data-locale={locale}
	data-labels={JSON.stringify(labels)}
>
	<!-- Mobile: floating trigger button (hidden at lg+) -->
	<div class="context-rules-panel__trigger-wrap lg:sl-hidden">
		<button
			type="button"
			class="context-rules-panel__trigger"
			id="kismeta-context-trigger"
			aria-haspopup="dialog"
			aria-controls="kismeta-context-modal"
			aria-expanded="false"
			aria-label={labels.title}
			data-context-trigger
		>
			<svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
				<path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/>
				<path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/>
			</svg>
		</button>
	</div>

	<!-- Mobile: bottom-sheet modal (opened/closed by JS) -->
	<div
		class="context-rules-panel__modal"
		id="kismeta-context-modal"
		role="dialog"
		aria-modal="true"
		aria-labelledby="kismeta-context-modal-title"
		hidden
		data-context-modal
	>
		<div class="context-rules-panel__modal-backdrop" data-context-modal-backdrop aria-hidden="true"></div>
		<div class="context-rules-panel__modal-sheet">
			<div class="context-rules-panel__modal-handle" aria-hidden="true"></div>
			<div class="context-rules-panel__modal-header">
				<h2 id="kismeta-context-modal-title" class="context-rules-panel__modal-title" data-context-mobile-label>{labels.title}</h2>
				<button
					type="button"
					class="context-rules-panel__modal-close"
					data-context-modal-close
					aria-label={labels.close}
				>
					<svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
						<path d="M18 6 6 18M6 6l12 12"/>
					</svg>
				</button>
			</div>
			<div class="context-rules-panel__modal-content">
				<p class="context-rules-panel__empty" data-context-mobile-empty>{labels.empty}</p>
				<div
					class="context-rules-panel__body sl-markdown-content"
					data-context-mobile-body
					hidden
				></div>
				<a
					class="context-rules-panel__link"
					data-context-mobile-link
					hidden
					target="_blank"
					rel="noopener"
				></a>
			</div>
		</div>
	</div>

	<div class="context-rules-panel__desktop right-sidebar-panel sl-hidden lg:sl-block">
		<div class="sl-container">
			<nav aria-labelledby="kismeta-context-title">
				<h2 id="kismeta-context-title" data-context-title>{labels.title}</h2>
				<p class="context-rules-panel__empty" data-context-empty>{labels.empty}</p>
				<div class="context-rules-panel__body sl-markdown-content" data-context-body hidden></div>
				<a
					class="context-rules-panel__link"
					data-context-link
					hidden
					target="_blank"
					rel="noopener"
				></a>
			</nav>
		</div>
	</div>
</div>

<script>
	import '../scripts/context-panel.ts';
</script>

<style>
	.context-rules-panel__desktop h2 {
		font-size: var(--sl-text-h5);
		font-weight: 600;
		margin-bottom: 0.5rem;
	}
</style>
