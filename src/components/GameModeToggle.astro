---
const t = Astro.locals.t;
---

<details class="game-mode-toggle">
	<summary class="game-mode-toggle__summary">
		<span class="game-mode-toggle__label">{t('gameMode.modifiers')}</span>
		<svg
			class="game-mode-toggle__chevron"
			aria-hidden="true"
			width="16"
			height="16"
			viewBox="0 0 24 24"
			fill="currentColor"
		>
			<path d="m9.29 6.71-1.41 1.41L13.17 13l-5.29 5.29 1.41 1.41L16 13z"></path>
		</svg>
	</summary>
	<div class="game-mode-toggle__controls">
		<label class="game-mode-toggle__option">
			<input type="checkbox" data-mode="quickplay" checked />
			{t('gameMode.quickplay')}
		</label>
		<label class="game-mode-toggle__option">
			<input type="checkbox" data-mode="magnus" checked />
			{t('gameMode.magnus')}
		</label>
	</div>
</details>

<script>
	function applyGameModes() {
		const quickplay = document.querySelector<HTMLInputElement>(
			'.game-mode-toggle input[data-mode="quickplay"]'
		);
		const magnus = document.querySelector<HTMLInputElement>(
			'.game-mode-toggle input[data-mode="magnus"]'
		);
		const showQuick = quickplay?.checked ?? true;
		const showMagnus = magnus?.checked ?? true;

		document.querySelectorAll<HTMLElement>('.game-mode-callout').forEach((el) => {
			const modes = (el.dataset.modes || '').split(/\s+/).filter(Boolean);
			const show =
				(modes.includes('quickplay') && showQuick) ||
				(modes.includes('magnus') && showMagnus);
			el.hidden = !show;
		});
	}

	function syncDetailsState() {
		const details = document.querySelector<HTMLDetailsElement>('details.game-mode-toggle');
		if (!details) return;
		// On desktop the details is always open; on mobile it starts closed
		if (window.matchMedia('(min-width: 50rem)').matches) {
			details.open = true;
		}
	}

	function init() {
		const saved = localStorage.getItem('kismeta-game-modes');
		if (saved) {
			try {
				const { quickplay, magnus } = JSON.parse(saved);
				const q = document.querySelector<HTMLInputElement>(
					'.game-mode-toggle input[data-mode="quickplay"]'
				);
				const m = document.querySelector<HTMLInputElement>(
					'.game-mode-toggle input[data-mode="magnus"]'
				);
				if (q) q.checked = quickplay;
				if (m) m.checked = magnus;
			} catch {
				/* ignore */
			}
		}

		syncDetailsState();
		applyGameModes();

		document.querySelectorAll('.game-mode-toggle input').forEach((input) => {
			input.addEventListener('change', () => {
				localStorage.setItem(
					'kismeta-game-modes',
					JSON.stringify({
						quickplay:
							document.querySelector<HTMLInputElement>(
								'.game-mode-toggle input[data-mode="quickplay"]'
							)?.checked ?? true,
						magnus:
							document.querySelector<HTMLInputElement>(
								'.game-mode-toggle input[data-mode="magnus"]'
							)?.checked ?? true,
					})
				);
				applyGameModes();
			});
		});
	}

	// Keep desktop always-open when viewport resizes across the 50rem boundary
	window.addEventListener('resize', () => {
		const details = document.querySelector<HTMLDetailsElement>('details.game-mode-toggle');
		if (details && window.matchMedia('(min-width: 50rem)').matches) {
			details.open = true;
		}
	});

	window.addEventListener('kismeta-game-modes-changed', applyGameModes);

	document.addEventListener('astro:page-load', init);
	init();
</script>
