---
import { getContextSectionIndex } from '../data/context-sections';
import { resolveContentLocale } from '../utils/locale';
import { siteT } from '../utils/site-i18n';

const locale = resolveContentLocale(Astro.currentLocale);
const sections = getContextSectionIndex(locale);

const labels = {
	title: siteT('playtest.agy.panel.title'),
	empty: siteT('playtest.agy.panel.empty'),
	openFull: siteT('playtest.agy.panel.openFull'),
	close: siteT('playtest.agy.panel.close'),
};
---

<div
	class="playtest-detail-panel"
	data-playtest-detail-panel
	data-sections={JSON.stringify(sections)}
	data-locale={locale}
	data-labels={JSON.stringify(labels)}
>
	<div
		class="playtest-detail-panel__modal"
		data-playtest-detail-modal
		role="dialog"
		aria-modal="true"
		aria-labelledby="playtest-detail-title"
		hidden
	>
		<div
			class="playtest-detail-panel__backdrop"
			data-playtest-detail-backdrop
			aria-hidden="true"
		></div>
		<div class="playtest-detail-panel__sheet">
			<div class="playtest-detail-panel__handle" aria-hidden="true"></div>
			<div class="playtest-detail-panel__header">
				<h2 id="playtest-detail-title" class="playtest-detail-panel__title" data-playtest-detail-title>
					{labels.title}
				</h2>
				<button
					type="button"
					class="playtest-detail-panel__close"
					data-playtest-detail-close
					aria-label={labels.close}
				>
					<svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
						<path d="M18 6 6 18M6 6l12 12"/>
					</svg>
				</button>
			</div>
			<div class="playtest-detail-panel__content">
				<p class="playtest-detail-panel__empty" data-playtest-detail-empty>{labels.empty}</p>
				<div
					class="playtest-detail-panel__body sl-markdown-content"
					data-playtest-detail-body
					hidden
				></div>
				<a
					class="playtest-detail-panel__link"
					data-playtest-detail-link
					hidden
					target="_blank"
					rel="noopener"
				></a>
			</div>
		</div>
	</div>
</div>

<script>
	import '../scripts/playtest-detail-panel.ts';
</script>
