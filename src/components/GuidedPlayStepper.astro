---
import { getRelativeLocaleUrl } from 'astro:i18n';
import ActionFlowGuide from './ActionFlowGuide.astro';
import CrucibleDeckBuilds from './CrucibleDeckBuilds.astro';
import GameTableEmbed from './GameTableEmbed.astro';
import { wikiSlug } from '../data/wiki-base';
import {
	getGuidedSteps,
	getGuidedNavSections,
	GUIDED_CONTENT_STEP_COUNT,
	type GameMode,
	type GuidedPhase,
	type GuidedStep,
} from '../data/guided-steps';

const locale = Astro.currentLocale ?? 'root';
const t = Astro.locals.t;
const steps = getGuidedSteps(locale === 'root' ? 'en' : locale);

function resolveLearnMore(step: GuidedStep): string | undefined {
	if (!step.learnMorePath) return undefined;
	const base = getRelativeLocaleUrl(locale, wikiSlug(step.learnMorePath));
	return step.learnMoreHash ? `${base}#${step.learnMoreHash}` : base;
}

const contentSteps = steps.slice(0, -1);
const completeStep = steps[steps.length - 1];

const stepsPayload = contentSteps.map((step) => ({
	...step,
	learnMoreUrl: resolveLearnMore(step),
}));

const completePayload = completeStep
	? {
			title: completeStep.title,
			body: completeStep.body,
		}
	: { title: '', body: '' };

const roundAtGlanceUrl = getRelativeLocaleUrl(locale, wikiSlug('rules/round-at-a-glance'));

const navSections = getGuidedNavSections().map((section) => ({
	id: section.id,
	stepIndex: section.stepIndex,
	label: t(section.labelKey),
}));
---

<div
	class="guided-play"
	data-steps={JSON.stringify(stepsPayload)}
	data-complete={JSON.stringify(completePayload)}
	data-step-count={GUIDED_CONTENT_STEP_COUNT}
	data-round-url={roundAtGlanceUrl}
	data-nav-sections={JSON.stringify(navSections)}
	data-labels={JSON.stringify({
		progress: t('guided.progress'),
		progressPhase: t('guided.progressPhase'),
		phaseSetup: t('guided.phase.setup'),
		phaseSpring: t('guided.phase.spring'),
		phaseSummer: t('guided.phase.summer'),
		phaseAutumn: t('guided.phase.autumn'),
		phaseWinter: t('guided.phase.winter'),
		back: t('guided.back'),
		next: t('guided.next'),
		learnMore: t('guided.learnMore'),
		modeTitle: t('guided.mode.title'),
		modeIntro: t('guided.mode.intro'),
		modeQuickplay: t('guided.mode.quickplay'),
		modeQuickplayDesc: t('guided.mode.quickplayDesc'),
		modeStandard: t('guided.mode.standard'),
		modeStandardDesc: t('guided.mode.standardDesc'),
		modeMagnus: t('guided.mode.magnus'),
		modeMagnusDesc: t('guided.mode.magnusDesc'),
		modeConfirm: t('guided.mode.confirm'),
		resumeTitle: t('guided.resume.title'),
		resumeBody: t('guided.resume.body'),
		resumeContinue: t('guided.resume.continue'),
		resumeFresh: t('guided.resume.fresh'),
		completeCta: t('guided.complete.cta'),
		continuePlaying: t('guided.complete.continuePlaying'),
		startOver: t('guided.startOver'),
		actionContextCollapse: t('guided.actionContext.collapse'),
		actionContextExpand: t('guided.actionContext.expand'),
		navTrigger: t('guided.nav.trigger'),
		navTitle: t('guided.nav.title'),
	})}
>
	<div class="guided-play__resume" hidden>
		<h2 class="guided-play__heading" data-resume-title></h2>
		<p class="guided-play__intro" data-resume-body></p>
		<div class="guided-play__resume-actions">
			<button type="button" class="guided-play__btn guided-play__btn--primary" data-action="resume">
			</button>
			<button type="button" class="guided-play__btn guided-play__btn--ghost" data-action="fresh">
			</button>
		</div>
	</div>

	<div class="guided-play__mode" hidden>
		<h2 class="guided-play__heading" data-mode-title tabindex="-1"></h2>
		<p class="guided-play__intro" data-mode-intro></p>
		<fieldset class="guided-play__mode-options">
			<legend class="guided-play__sr-only" data-mode-title-legend></legend>
			<label class="guided-play__mode-option">
				<input type="radio" name="guided-mode" value="quickplay" />
				<span class="guided-play__mode-label" data-mode-quickplay></span>
				<span class="guided-play__mode-desc" data-mode-quickplay-desc></span>
			</label>
			<label class="guided-play__mode-option">
				<input type="radio" name="guided-mode" value="standard" checked />
				<span class="guided-play__mode-label" data-mode-standard></span>
				<span class="guided-play__mode-desc" data-mode-standard-desc></span>
			</label>
			<label class="guided-play__mode-option">
				<input type="radio" name="guided-mode" value="magnus" />
				<span class="guided-play__mode-label" data-mode-magnus></span>
				<span class="guided-play__mode-desc" data-mode-magnus-desc></span>
			</label>
		</fieldset>
		<button type="button" class="guided-play__btn guided-play__btn--primary" data-action="confirm-mode">
		</button>
	</div>

	<div class="guided-play__main" hidden>
		<div class="guided-play__progress-wrap" aria-hidden="false">
			<div class="guided-play__progress-header">
				<p class="guided-play__progress-text" data-progress-text></p>
				<div class="guided-play__nav">
					<button
						type="button"
						class="guided-play__nav-trigger"
						data-nav-trigger
						aria-expanded="false"
						aria-controls="guided-play-nav-panel"
						aria-label={t('guided.nav.trigger')}
					>
						{t('guided.nav.trigger')}
					</button>
					<div
						id="guided-play-nav-panel"
						class="guided-play__nav-panel"
						data-nav-panel
						role="menu"
						aria-label={t('guided.nav.title')}
						hidden
					>
						{
							navSections.map((section) => (
								<button
									type="button"
									class="guided-play__nav-item"
									role="menuitem"
									data-nav-section={section.id}
									data-nav-step={section.stepIndex}
								>
									{section.label}
								</button>
							))
						}
					</div>
				</div>
			</div>
			<div
				class="guided-play__progress-bar"
				role="progressbar"
				aria-valuemin="1"
				aria-valuemax={GUIDED_CONTENT_STEP_COUNT}
			>
				<div class="guided-play__progress-fill" data-progress-fill></div>
			</div>
		</div>

		<article class="guided-play__step" aria-live="polite">
			<h2 class="guided-play__heading" data-step-title tabindex="-1"></h2>
			<div class="guided-play__body" data-step-body></div>
			<ul class="guided-play__checklist" data-step-checklist hidden></ul>
			<div class="guided-play__embed" data-step-embed hidden>
				<div class="guided-play__embed-panel" data-embed-panel="crucible-deck" hidden>
					<CrucibleDeckBuilds variant="interactive" />
				</div>
				<div class="guided-play__embed-panel" data-embed-panel="harvest-order" hidden>
					<GameTableEmbed tableId="harvest-order" />
				</div>
				<div class="guided-play__embed-panel" data-embed-panel="round-at-a-glance" hidden>
					<GameTableEmbed tableId="round-at-a-glance" />
				</div>
				<div class="guided-play__embed-panel" data-embed-panel="summer-flow" hidden>
					<ActionFlowGuide flowId="summer-flow" />
				</div>
				<div class="guided-play__embed-panel" data-embed-panel="autumn-flow" hidden>
					<ActionFlowGuide flowId="autumn-flow" />
				</div>
				<div class="guided-play__embed-panel" data-embed-panel="winter-flow" hidden>
					<ActionFlowGuide flowId="winter-flow" />
				</div>
			</div>
			<p class="guided-play__learn-more-wrap" data-learn-more-wrap hidden>
				<a class="guided-play__learn-more" data-learn-more href="#" target="_blank" rel="noopener">
				</a>
			</p>
		</article>

		<footer class="guided-play__footer">
			<div class="guided-play__action-context" data-action-context hidden>
				<div class="guided-play__action-context-header">
					<span class="guided-play__action-context-title" data-action-context-title></span>
					<button
						type="button"
						class="guided-play__action-context-toggle"
						data-action-context-toggle
						aria-expanded="true"
					>
						<svg
							class="guided-play__action-context-toggle-icon"
							aria-hidden="true"
							width="14"
							height="14"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2.5"
							stroke-linecap="round"
							stroke-linejoin="round"
						>
							<path d="M18 15l-6-6-6 6"/>
						</svg>
					</button>
				</div>
				<div class="guided-play__action-context-content" data-action-context-content aria-live="polite">
					<p class="guided-play__action-context-body" data-action-context-body></p>
					<p class="guided-play__action-context-meta" data-action-context-condition hidden></p>
					<p class="guided-play__action-context-meta" data-action-context-mode hidden></p>
					<a
						class="guided-play__action-context-link"
						data-action-context-learn
						hidden
						href="#"
						target="_blank"
						rel="noopener"
					></a>
				</div>
			</div>
			<div class="guided-play__footer-nav">
				<span class="guided-play__footer-nav-label" data-footer-nav-label></span>
				<div class="guided-play__footer-nav-btns">
					<button type="button" class="guided-play__btn guided-play__btn--ghost" data-action="back"></button>
					<button type="button" class="guided-play__btn guided-play__btn--primary" data-action="next"></button>
				</div>
			</div>
		</footer>
	</div>

	<div class="guided-play__complete" hidden>
		<article class="guided-play__step" aria-live="polite">
			<h2 class="guided-play__heading" data-complete-title tabindex="-1"></h2>
			<div class="guided-play__body" data-complete-body></div>
		</article>
		<div class="guided-play__complete-actions">
			<button type="button" class="guided-play__btn guided-play__btn--primary" data-action="continue-playing"></button>
			<a class="guided-play__btn guided-play__btn--ghost" data-complete-cta href={roundAtGlanceUrl}></a>
			<button type="button" class="guided-play__btn guided-play__btn--ghost" data-action="start-over"></button>
		</div>
	</div>
</div>

<script>
	import { applyGameModeCallouts } from '../scripts/game-modes';
	import {
		GAME_MODE_STORAGE_KEY,
		GUIDED_PROGRESS_KEY,
		GUIDED_PROGRESS_VERSION,
		gameModeToStorage,
		type GameMode,
		type GuidedStep,
	} from '../data/guided-steps';

	type Labels = {
		progress: string;
		progressPhase: string;
		phaseSetup: string;
		phaseSpring: string;
		phaseSummer: string;
		phaseAutumn: string;
		phaseWinter: string;
		back: string;
		next: string;
		learnMore: string;
		modeTitle: string;
		modeIntro: string;
		modeQuickplay: string;
		modeQuickplayDesc: string;
		modeStandard: string;
		modeStandardDesc: string;
		modeMagnus: string;
		modeMagnusDesc: string;
		modeConfirm: string;
		resumeTitle: string;
		resumeBody: string;
		resumeContinue: string;
		resumeFresh: string;
		completeCta: string;
		continuePlaying: string;
		startOver: string;
		actionContextCollapse: string;
		actionContextExpand: string;
		navTrigger: string;
		navTitle: string;
	};

	type NavSection = {
		id: string;
		label: string;
		stepIndex: number;
	};

	type ProgressState = {
		version: number;
		mode: GameMode;
		stepIndex: number;
	};

	function setGameMode(mode: GameMode) {
		localStorage.setItem(GAME_MODE_STORAGE_KEY, JSON.stringify(gameModeToStorage(mode)));
		window.dispatchEvent(new CustomEvent('kismeta-game-modes-changed'));
		applyGameModeCallouts();
	}

	function loadProgress(): ProgressState | null {
		const raw = localStorage.getItem(GUIDED_PROGRESS_KEY);
		if (!raw) return null;
		try {
			const data = JSON.parse(raw) as ProgressState;
			if (data.version !== GUIDED_PROGRESS_VERSION) return null;
			if (!['quickplay', 'standard', 'magnus'].includes(data.mode)) return null;
			if (typeof data.stepIndex !== 'number' || data.stepIndex < 1) return null;
			return data;
		} catch {
			return null;
		}
	}

	function saveProgress(mode: GameMode, stepIndex: number) {
		const state: ProgressState = {
			version: GUIDED_PROGRESS_VERSION,
			mode,
			stepIndex,
		};
		localStorage.setItem(GUIDED_PROGRESS_KEY, JSON.stringify(state));
	}

	function clearProgress() {
		localStorage.removeItem(GUIDED_PROGRESS_KEY);
	}

	function initGuidedPlay() {
		const root = document.querySelector<HTMLElement>('.guided-play');
		if (!root || root.dataset.bound === 'true') return;
		root.dataset.bound = 'true';

		const steps = JSON.parse(root.dataset.steps || '[]') as (GuidedStep & {
			learnMoreUrl?: string;
			embed?: string;
		})[];
		const complete = JSON.parse(root.dataset.complete || '{}') as {
			title: string;
			body: string;
		};
		const stepCount = Number(root.dataset.stepCount) || steps.length;
		const labels = JSON.parse(root.dataset.labels || '{}') as Labels;
		const navSections = JSON.parse(root.dataset.navSections || '[]') as NavSection[];

		const resumeEl = root.querySelector<HTMLElement>('.guided-play__resume')!;
		const modeEl = root.querySelector<HTMLElement>('.guided-play__mode')!;
		const mainEl = root.querySelector<HTMLElement>('.guided-play__main')!;
		const completeEl = root.querySelector<HTMLElement>('.guided-play__complete')!;

		let mode: GameMode = 'standard';
		let stepIndex = 1;

		const setText = (sel: string, text: string) => {
			const el = root.querySelector(sel);
			if (el) el.textContent = text;
		};

		const setHtml = (sel: string, html: string) => {
			const el = root.querySelector(sel);
			if (el) el.innerHTML = html;
		};

		const hideAll = () => {
			resumeEl.hidden = true;
			modeEl.hidden = true;
			mainEl.hidden = true;
			completeEl.hidden = true;
		};

		const focusHeading = (container: ParentNode) => {
			const h = container.querySelector<HTMLElement>('.guided-play__heading');
			h?.focus();
		};

		const dispatchContext = (path?: string, hash?: string) => {
			window.dispatchEvent(
				new CustomEvent('kismeta:context', {
					detail: { path: path ?? '', hash: hash ?? '' },
				})
			);
		};

		const actionContext = root.querySelector<HTMLElement>('[data-action-context]')!;
		const actionContextTitle = root.querySelector<HTMLElement>('[data-action-context-title]')!;
		const actionContextToggle = root.querySelector<HTMLButtonElement>('[data-action-context-toggle]')!;
		const actionContextContent = root.querySelector<HTMLElement>('[data-action-context-content]')!;
		const actionContextBody = root.querySelector<HTMLElement>('[data-action-context-body]')!;
		const actionContextCondition = root.querySelector<HTMLElement>('[data-action-context-condition]')!;
		const actionContextMode = root.querySelector<HTMLElement>('[data-action-context-mode]')!;
		const actionContextLearn = root.querySelector<HTMLAnchorElement>('[data-action-context-learn]')!;

		let actionContextExpanded = true;

		const syncToggle = (expanded: boolean) => {
			actionContextToggle.setAttribute('aria-expanded', String(expanded));
			actionContextToggle.setAttribute(
				'aria-label',
				expanded ? labels.actionContextCollapse : labels.actionContextExpand
			);
			actionContextContent.hidden = !expanded;
			actionContext.classList.toggle('guided-play__action-context--collapsed', !expanded);
		};

		actionContextToggle.addEventListener('click', () => {
			actionContextExpanded = !actionContextExpanded;
			syncToggle(actionContextExpanded);
		});

		const clearActionContext = () => {
			actionContext.hidden = true;
			actionContextTitle.textContent = '';
			actionContextBody.textContent = '';
			actionContextCondition.hidden = true;
			actionContextCondition.textContent = '';
			actionContextMode.hidden = true;
			actionContextMode.textContent = '';
			actionContextLearn.hidden = true;
			actionContextExpanded = true;
			syncToggle(true);
			root.querySelectorAll('.action-flow__pick--active').forEach((el) => {
				el.classList.remove('action-flow__pick--active');
			});
		};

		const showActionContext = (detail: {
			title?: string;
			body?: string;
			condition?: string;
			modeNote?: string;
			learnHref?: string;
			learnLabel?: string;
			visible?: boolean;
		}) => {
			if (!detail.visible) {
				clearActionContext();
				return;
			}

			actionContextTitle.textContent = detail.title || '';
			actionContextBody.textContent = detail.body || '';
			if (detail.condition) {
				actionContextCondition.hidden = false;
				actionContextCondition.innerHTML = `<em>${detail.condition}</em>`;
			} else {
				actionContextCondition.hidden = true;
				actionContextCondition.textContent = '';
			}

			if (detail.modeNote) {
				actionContextMode.hidden = false;
				actionContextMode.textContent = detail.modeNote;
			} else {
				actionContextMode.hidden = true;
				actionContextMode.textContent = '';
			}

			if (detail.learnHref) {
				actionContextLearn.hidden = false;
				actionContextLearn.href = detail.learnHref;
				actionContextLearn.textContent = detail.learnLabel || labels.learnMore;
			} else {
				actionContextLearn.hidden = true;
			}

			// Always expand when new content arrives
			actionContextExpanded = true;
			syncToggle(true);
			actionContext.hidden = false;
		};

		window.addEventListener('kismeta:action-detail', ((event: CustomEvent) => {
			showActionContext(event.detail ?? {});
		}) as EventListener);

		const navTrigger = root.querySelector<HTMLButtonElement>('[data-nav-trigger]')!;
		const navPanel = root.querySelector<HTMLElement>('[data-nav-panel]')!;
		let navOpen = false;

		const getCurrentSectionId = (index: number): string => {
			for (let i = navSections.length - 1; i >= 0; i--) {
				if (index >= navSections[i]!.stepIndex) {
					return navSections[i]!.id;
				}
			}
			return navSections[0]?.id ?? '';
		};

		const syncNavActive = () => {
			const activeId = getCurrentSectionId(stepIndex);
			root.querySelectorAll<HTMLButtonElement>('[data-nav-section]').forEach((btn) => {
				const isActive = btn.dataset.navSection === activeId;
				btn.setAttribute('aria-current', isActive ? 'true' : 'false');
				btn.classList.toggle('guided-play__nav-item--active', isActive);
			});
		};

		const closeNavPanel = () => {
			navOpen = false;
			navPanel.hidden = true;
			navTrigger.setAttribute('aria-expanded', 'false');
		};

		const openNavPanel = () => {
			navOpen = true;
			navPanel.hidden = false;
			navTrigger.setAttribute('aria-expanded', 'true');
			syncNavActive();
			navPanel.querySelector<HTMLElement>('[data-nav-section]')?.focus();
		};

		navTrigger.addEventListener('click', () => {
			if (navOpen) {
				closeNavPanel();
				navTrigger.focus();
			} else {
				openNavPanel();
			}
		});

		navPanel.addEventListener('keydown', (e: KeyboardEvent) => {
			if (e.key === 'Escape') {
				e.stopPropagation();
				closeNavPanel();
				navTrigger.focus();
			}
		});

		document.addEventListener('click', (e: MouseEvent) => {
			const nav = root.querySelector('.guided-play__nav');
			if (navOpen && nav && !nav.contains(e.target as Node)) {
				closeNavPanel();
			}
		});

		root.querySelectorAll<HTMLButtonElement>('[data-nav-section]').forEach((btn) => {
			btn.addEventListener('click', () => {
				const target = Number(btn.dataset.navStep);
				if (!target || target === stepIndex) {
					closeNavPanel();
					navTrigger.focus();
					return;
				}
				stepIndex = target;
				renderStep();
				closeNavPanel();
				navTrigger.focus();
			});
		});

		const renderStep = () => {
			const step = steps[stepIndex - 1];
			if (!step) return;

			clearActionContext();

			setText('[data-step-title]', step.title);
			let body = step.body;
			if (step.modeBody && step.modeBody[mode]) {
				body = step.modeBody[mode]!;
			}
			setHtml('[data-step-body]', body);

			const checklist = root.querySelector<HTMLUListElement>('[data-step-checklist]')!;
			checklist.replaceChildren();
			if (step.checklist?.length) {
				checklist.hidden = false;
				for (const item of step.checklist) {
					const li = document.createElement('li');
					li.textContent = item;
					checklist.append(li);
				}
			} else {
				checklist.hidden = true;
			}

			const embedEl = root.querySelector<HTMLElement>('[data-step-embed]')!;
			const embedId = step.embed ?? '';
			embedEl.hidden = !embedId;
			root.querySelectorAll<HTMLElement>('[data-embed-panel]').forEach((panel) => {
				panel.hidden = panel.dataset.embedPanel !== embedId;
			});
			if (embedId === 'crucible-deck') {
				window.dispatchEvent(new CustomEvent('crucible-deck-refresh'));
			}

			const phaseLabel = (phase?: GuidedPhase) => {
				if (!phase) return '';
				const map: Record<GuidedPhase, string> = {
					setup: labels.phaseSetup,
					spring: labels.phaseSpring,
					summer: labels.phaseSummer,
					autumn: labels.phaseAutumn,
					winter: labels.phaseWinter,
				};
				return map[phase] ?? '';
			};

			const learnWrap = root.querySelector<HTMLElement>('[data-learn-more-wrap]')!;
			const learnLink = root.querySelector<HTMLAnchorElement>('[data-learn-more]')!;
			if (step.learnMoreUrl) {
				learnWrap.hidden = false;
				learnLink.href = step.learnMoreUrl;
				learnLink.textContent = labels.learnMore;
			} else {
				learnWrap.hidden = true;
			}

			dispatchContext(step.learnMorePath, step.learnMoreHash);
		// If an embedded wizard is now visible, let it override with its active
		// panel's specific context (e.g. Autumn/Winter wizard panels).
		window.dispatchEvent(new CustomEvent('kismeta:wizard-refocus'));

			let progressText = labels.progress
				.replace('{current}', String(stepIndex))
				.replace('{total}', String(stepCount));
			if (step.phase && step.phaseStep != null && step.phaseTotal != null) {
				progressText = labels.progressPhase
					.replace('{phase}', phaseLabel(step.phase))
					.replace('{current}', String(step.phaseStep))
					.replace('{total}', String(step.phaseTotal));
			}
			setText('[data-progress-text]', progressText);

			const footerNavLabel = root.querySelector<HTMLElement>('[data-footer-nav-label]')!;
			footerNavLabel.textContent = progressText;

			const bar = root.querySelector<HTMLElement>('[data-progress-fill]')!;
			const pct = (stepIndex / stepCount) * 100;
			bar.style.width = `${pct}%`;

			const progressbar = root.querySelector<HTMLElement>('.guided-play__progress-bar')!;
			progressbar.setAttribute('aria-valuenow', String(stepIndex));
			progressbar.setAttribute('aria-valuemax', String(stepCount));

			const backBtn = root.querySelector<HTMLButtonElement>('[data-action="back"]')!;
			const nextBtn = root.querySelector<HTMLButtonElement>('[data-action="next"]')!;
			backBtn.disabled = stepIndex <= 1;
			nextBtn.textContent =
				stepIndex >= stepCount ? labels.next : labels.next;

			saveProgress(mode, stepIndex);
			syncNavActive();
			focusHeading(mainEl);
		};

		const showMain = () => {
			hideAll();
			mainEl.hidden = false;
			renderStep();
		};

		const showComplete = () => {
			hideAll();
			setText('[data-complete-title]', complete.title ?? '');
			setHtml('[data-complete-body]', complete.body ?? '');
			const cta = root.querySelector<HTMLAnchorElement>('[data-complete-cta]')!;
			cta.textContent = labels.completeCta;
			completeEl.hidden = false;
			saveProgress(mode, stepCount + 1);
			focusHeading(completeEl);
			dispatchContext();
		};

		const showMode = () => {
			hideAll();
			modeEl.hidden = false;
			focusHeading(modeEl);
			dispatchContext();
		};

		const showResume = (saved: ProgressState) => {
			hideAll();
			resumeEl.hidden = false;
			focusHeading(resumeEl);
			dispatchContext();
		};

		// Static labels
		setText('[data-resume-title]', labels.resumeTitle);
		setText('[data-resume-body]', labels.resumeBody);
		root.querySelector<HTMLButtonElement>('[data-action="resume"]')!.textContent =
			labels.resumeContinue;
		root.querySelector<HTMLButtonElement>('[data-action="fresh"]')!.textContent =
			labels.resumeFresh;

		setText('[data-mode-title]', labels.modeTitle);
		setText('[data-mode-title-legend]', labels.modeTitle);
		setText('[data-mode-intro]', labels.modeIntro);
		setText('[data-mode-quickplay]', labels.modeQuickplay);
		setText('[data-mode-quickplay-desc]', labels.modeQuickplayDesc);
		setText('[data-mode-standard]', labels.modeStandard);
		setText('[data-mode-standard-desc]', labels.modeStandardDesc);
		setText('[data-mode-magnus]', labels.modeMagnus);
		setText('[data-mode-magnus-desc]', labels.modeMagnusDesc);
		root.querySelector<HTMLButtonElement>('[data-action="confirm-mode"]')!.textContent =
			labels.modeConfirm;

		setText('[data-action="back"]', labels.back);
		setText('[data-action="next"]', labels.next);
		setText('[data-action="start-over"]', labels.startOver);
		setText('[data-action="continue-playing"]', labels.continuePlaying);

		// Index of the first Spring step (1-based) â€” the loop re-entry point
		const springStepIndex = steps.findIndex((s) => s.id === 'spring-1') + 1 || 1;

		root.querySelector<HTMLButtonElement>('[data-action="resume"]')!.addEventListener('click', () => {
			const saved = loadProgress();
			if (!saved) {
				showMode();
				return;
			}
			mode = saved.mode;
			stepIndex = saved.stepIndex;
			setGameMode(mode);
			if (stepIndex > stepCount) {
				showComplete();
			} else {
				showMain();
			}
		});

		root.querySelector<HTMLButtonElement>('[data-action="fresh"]')!.addEventListener('click', () => {
			clearProgress();
			showMode();
		});

		root.querySelector<HTMLButtonElement>('[data-action="confirm-mode"]')!.addEventListener(
			'click',
			() => {
				const selected = root.querySelector<HTMLInputElement>(
					'input[name="guided-mode"]:checked'
				)?.value as GameMode;
				mode = selected || 'standard';
				setGameMode(mode);
				stepIndex = 1;
				showMain();
			}
		);

		root.querySelector<HTMLButtonElement>('[data-action="back"]')!.addEventListener('click', () => {
			if (stepIndex <= 1) return;
			stepIndex -= 1;
			renderStep();
		});

		root.querySelector<HTMLButtonElement>('[data-action="next"]')!.addEventListener('click', () => {
			if (stepIndex >= stepCount) {
				showComplete();
				return;
			}
			stepIndex += 1;
			renderStep();
		});

		window.addEventListener('kismeta:guided-advance', () => {
			if (mainEl.hidden) return;
			if (stepIndex >= stepCount) {
				showComplete();
				return;
			}
			stepIndex += 1;
			renderStep();
		});

		root.querySelector<HTMLButtonElement>('[data-action="start-over"]')!.addEventListener(
			'click',
			() => {
				clearProgress();
				stepIndex = 1;
				mode = 'standard';
				const standardRadio = root.querySelector<HTMLInputElement>(
					'input[name="guided-mode"][value="standard"]'
				);
				if (standardRadio) standardRadio.checked = true;
				showMode();
			}
		);

		root.querySelector<HTMLButtonElement>('[data-action="continue-playing"]')?.addEventListener(
			'click',
			() => {
				stepIndex = springStepIndex;
				showMain();
			}
		);

		const saved = loadProgress();
		if (saved) {
			mode = saved.mode;
			stepIndex = saved.stepIndex;
			const modeRadio = root.querySelector<HTMLInputElement>(
				`input[name="guided-mode"][value="${mode}"]`
			);
			if (modeRadio) modeRadio.checked = true;
			showResume(saved);
		} else {
			showMode();
		}
	}

	document.addEventListener('astro:page-load', initGuidedPlay);
	initGuidedPlay();
</script>

